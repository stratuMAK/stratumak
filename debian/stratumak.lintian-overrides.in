# These are binaries that interact with hardware.
#
# gomc-server uses Linux capabilities (setcap) for realtime
# privileges instead of setuid.

# that is intentional - for now
@MAIN_PACKAGE_NAME@: package-name-doesnt-match-sonames liblinuxcnchal0 liblinuxcncini0 libnml0 libposemath0 libpyplugin0 librs274-0 libtooldata0

# These are dlopened by gomc-server, which is already linked against libc.
@MAIN_PACKAGE_NAME@: library-not-linked-against-libc [usr/lib/linuxcnc/modules/*.so]

# Not of immediate concern - https://lintian.debian.org/tags/shared-library-lacks-prerequisites.html
@MAIN_PACKAGE_NAME@: shared-library-lacks-prerequisites [usr/lib/linuxcnc/modules/*.so]

# /usr/bin/gomc-server points into /var/lib/stratumak, which the package
# deliberately does not ship: if dpkg owned that path, every upgrade would
# unpack the shipped symlink over a locally rebuilt server and discard it.
# postinst creates the target. See EXTERNAL_MODULE_INSTALL_DESIGN.md 4.1.
@MAIN_PACKAGE_NAME@: package-contains-broken-symlink [usr/bin/gomc-server]
@MAIN_PACKAGE_NAME@: dangling-symlink [usr/bin/gomc-server]
@MAIN_PACKAGE_NAME@: symlink-target-in-var [usr/bin/gomc-server]

# The pristine server lives in /usr/libexec rather than /usr/lib: it is a
# program, invoked through the symlink chain above, not a library.
@MAIN_PACKAGE_NAME@: file-in-unusual-dir [usr/libexec/stratumak/gomc-server]
