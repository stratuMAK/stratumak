# These are binaries that interact with hardware.
#
# gomc-server uses Linux capabilities (setcap) for realtime
# privileges instead of setuid.

# One package ships all project libraries; splitting per-soname packages for
# private libraries nothing external links against would be churn for its own
# sake. The list must match what the package actually ships or lintian
# reports mismatched-override.
@MAIN_PACKAGE_NAME@: package-name-doesnt-match-sonames libethercat2 libgmi0 libiniparse0 libposemath0 librs274-0 librtapi-core0 librtapi-parport0 librtapi-pci0

# hm2_modbus.so/setsserial.so resolve hostmot2.so (same private cmod
# directory, deliberately no SONAME) via an absolute DT_RPATH. The directory
# is no loader default and must not be: these are plugins, not public
# libraries. $ORIGIN is not usable — gomc-server runs with file capabilities
# (AT_SECURE), where the loader ignores it.
@MAIN_PACKAGE_NAME@: custom-library-search-path RPATH /usr/lib/linuxcnc/cmod [usr/lib/linuxcnc/cmod/hm2_modbus.so]
@MAIN_PACKAGE_NAME@: custom-library-search-path RPATH /usr/lib/linuxcnc/cmod [usr/lib/linuxcnc/cmod/setsserial.so]

# Legacy gmoccapy icon set: a handful of its fixed-size PNGs are not exactly
# the size of their directory. Upstream artwork, cosmetic only.
@MAIN_PACKAGE_NAME@: icon-size-and-directory-name-mismatch * [usr/share/gmoccapy/icons/*]

# These are dlopened by gomc-server, which is already linked against libc.
@MAIN_PACKAGE_NAME@: library-not-linked-against-libc [usr/lib/linuxcnc/modules/*.so]

# Not of immediate concern - https://lintian.debian.org/tags/shared-library-lacks-prerequisites.html
@MAIN_PACKAGE_NAME@: shared-library-lacks-prerequisites [usr/lib/linuxcnc/modules/*.so]

# No override for /usr/bin/gomc-server pointing into /var/lib/stratumak, nor
# for the pristine binary living in /usr/libexec: lintian objects to neither,
# and four overrides written on the assumption that it would were three
# invented tag names (alien-tag, an error in its own right) and one that never
# fires. Overrides go here after lintian has been seen to emit the tag, not
# before.
