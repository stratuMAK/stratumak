usr/bin/gmcui usr/bin/halscope
usr/bin/gmcui usr/bin/emccalib
usr/bin/gmcui usr/bin/tooledit
usr/bin/gmcui usr/bin/latency
usr/bin/gmcui usr/bin/classicladder
usr/bin/gmcui usr/bin/linuxcnctop-ui
