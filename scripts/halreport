#!/usr/bin/env python3
"""halreport — collect one diagnostic bundle for a support question.

The old halreport was a Tcl HAL-topology printer built on the Tcl HAL binding,
which no longer exists. This is deliberately not a port of it: the goal is the
"short access path" item in PRODUCTION_READINESS.md -- one command that gathers
what is needed to answer a support question from a machine in the field.
Versions, host and RT environment, the config that was actually loaded, live
HAL topology and thread timing, machine state, and logs.

It runs ON the machine, because half of what matters (kernel, distro, INI and
HAL files, journal) is not reachable over REST. It talks to a running
gomc-server for the other half, and degrades to the host-only sections when no
server is up -- a machine that will not start is exactly when a report is
wanted.

Usage:
    halreport [-o OUTPUT] [--ini FILE] [--stdout] [--journal-lines N]

    -o OUTPUT         bundle path (default: ./halreport-<host>-<stamp>.tar.gz)
    --ini FILE        INI file to record; default $INI_FILE_NAME
    --stdout          write the text report to stdout, make no bundle
    --journal-lines N journal lines to capture (default 2000)

Environment: GMC_REST_URL (default http://127.0.0.1:5080), GMC_INSTANCE.
"""

import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request

REST_TIMEOUT = 5.0
SEP = "=" * 78


# ─── plumbing ───

def run(cmd, timeout=15):
    """Run a host command, returning its output or a readable failure line.

    Never raises: a missing tool on a customer machine must cost one line of
    the report, not the report.
    """
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return "<not installed: %s>" % cmd[0]
    except subprocess.TimeoutExpired:
        return "<timed out: %s>" % " ".join(cmd)
    except Exception as e:                                    # noqa: BLE001
        return "<failed: %s: %s>" % (" ".join(cmd), e)
    out = (p.stdout or "") + (p.stderr or "")
    return out.strip() or "<no output>"


def rest_url():
    return os.environ.get("GMC_REST_URL", "http://127.0.0.1:5080").rstrip("/")


def instance():
    return os.environ.get("GMC_INSTANCE", "milltask")


def get_json(path):
    """GET one REST path. Returns (data, None) or (None, reason)."""
    url = rest_url() + path
    try:
        with urllib.request.urlopen(url, timeout=REST_TIMEOUT) as r:
            return json.loads(r.read()), None
    except urllib.error.HTTPError as e:
        return None, "HTTP %s" % e.code
    except Exception as e:                                    # noqa: BLE001
        return None, str(e)


def as_int(v):
    """Coerce a JSON number that may be a string.

    64-bit fields cross the wire as strings (they would lose precision as
    JavaScript numbers), so period and runtime arrive quoted.
    """
    try:
        return int(v)
    except (TypeError, ValueError):
        return 0


def as_list(data):
    """REST collections arrive either as a list or wrapped in a single key."""
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for v in data.values():
            if isinstance(v, list):
                return v
    return []


class Report:
    def __init__(self):
        self.lines = []
        self.files = {}      # name inside the bundle -> path on disk

    def section(self, title):
        self.lines += ["", SEP, title, SEP]

    def kv(self, key, value):
        self.lines.append("%-24s %s" % (key + ":", value))

    def text(self, body):
        self.lines.append(body if isinstance(body, str) else "\n".join(body))

    def note(self, body):
        self.lines.append("  (%s)" % body)

    def attach(self, name, path):
        self.files[name] = path

    def render(self):
        return "\n".join(self.lines) + "\n"


# ─── sections ───

def sec_report(rep):
    rep.section("REPORT")
    rep.kv("Generated", datetime.datetime.now().astimezone().isoformat(timespec="seconds"))
    rep.kv("Host", run(["hostname"]))
    rep.kv("User", "%s (uid %d)" % (run(["id", "-un"]), os.getuid()))
    rep.kv("Groups", run(["id", "-Gn"]))
    rep.kv("Command", " ".join(sys.argv))
    rep.kv("REST URL", rest_url())
    rep.kv("Instance", instance())


def sec_version(rep):
    rep.section("VERSION")
    rep.kv("LINUXCNCVERSION", os.environ.get("LINUXCNCVERSION", "<unset>"))
    exe = shutil.which("gomc-server")
    rep.kv("gomc-server", exe or "<not on PATH>")
    top = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    vfile = os.path.join(top, "VERSION")
    if os.path.exists(vfile):
        with open(vfile) as f:
            rep.kv("VERSION file", f.read().strip())
    if os.path.isdir(os.path.join(top, ".git")):
        rep.note("run-in-place tree: %s" % top)
        rep.kv("git commit", run(["git", "-C", top, "rev-parse", "--short", "HEAD"]))
        dirty = run(["git", "-C", top, "status", "--porcelain"])
        rep.kv("git worktree", "clean" if dirty == "<no output>" else "MODIFIED")
        if dirty != "<no output>":
            rep.text(dirty)


def sec_host(rep):
    rep.section("HOST / REAL-TIME ENVIRONMENT")
    rep.kv("uname -a", run(["uname", "-a"]))
    rep.kv("distro", run(["lsb_release", "-d"]))
    for label, path in (("kernel cmdline", "/proc/cmdline"),
                        ("isolated cpus", "/sys/devices/system/cpu/isolated")):
        try:
            with open(path) as f:
                rep.kv(label, f.read().strip() or "<none>")
        except OSError as e:
            rep.kv(label, "<unreadable: %s>" % e)
    rep.kv("cpu", run(["sh", "-c",
                       "grep -m1 'model name' /proc/cpuinfo | cut -d: -f2-"]))
    rep.kv("cores", run(["nproc"]))
    rep.kv("memory", run(["sh", "-c", "free -h | sed -n 2p"]))
    rep.kv("uptime", run(["uptime"]))
    # memlock matters: the RT path prefaults and locks its memory.
    rep.text("\nProcess limits (ulimit -a):")
    rep.text(run(["sh", "-c", "ulimit -a"]))


def sec_server(rep):
    rep.section("SERVER")
    status, err = get_json("/api/v1/halcmd/status")
    if err:
        rep.kv("state", "NOT REACHABLE (%s)" % err)
        rep.note("the host sections are still valid; every section below needs "
                 "a running gomc-server")
        return False
    rep.kv("state", "reachable")
    rep.text(json.dumps(status, indent=2))

    info, err = get_json("/api/v1/%s/info" % instance())
    rep.text("\nTask peers and capabilities (%s):" % instance())
    rep.text(json.dumps(info, indent=2) if not err else "  <unavailable: %s>" % err)
    return True


def sec_config(rep, args):
    rep.section("CONFIGURATION")
    ini = args.ini or os.environ.get("INI_FILE_NAME")
    if not ini:
        rep.note("no INI file known: $INI_FILE_NAME is unset -- pass --ini to "
                 "record the config")
        return
    rep.kv("INI file", ini)
    if not os.path.exists(ini):
        rep.note("that path does not exist on this host")
        return
    rep.attach("config/" + os.path.basename(ini), ini)
    cfgdir = os.path.dirname(os.path.abspath(ini))
    rep.kv("config dir", cfgdir)

    # Attach the files the INI names, so the bundle explains itself without a
    # follow-up round trip. LIB: files are skipped: they are system files,
    # identical on every host, and shipping them buries the local ones.
    wanted = ("HALFILE", "POSTGUI_HALFILE", "TOOL_TABLE", "PARAMETER_FILE",
              "PYVCP", "GLADEVCP", "OPEN_FILE")
    attached = []
    try:
        with open(ini, errors="replace") as f:
            for raw in f:
                line = raw.split("#", 1)[0].strip()
                if "=" not in line:
                    continue
                key, val = (s.strip() for s in line.split("=", 1))
                if key not in wanted or not val:
                    continue
                name = val.split()[0]
                if name.startswith("LIB:"):
                    attached.append("%s = %s   (system file, not attached)" % (key, name))
                    continue
                cand = name if os.path.isabs(name) else os.path.join(cfgdir, name)
                if os.path.isfile(cand):
                    rep.attach("config/" + os.path.basename(cand), cand)
                    attached.append("%s = %s" % (key, name))
                else:
                    attached.append("%s = %s   (not in the config dir; resolved from the library path, or created at run time)"
                                    % (key, name))
    except OSError as e:
        rep.note("could not scan the INI: %s" % e)
    rep.text("\nFiles named by the INI:")
    rep.text(["  " + a for a in attached] or ["  <none>"])


def sec_machine(rep):
    rep.section("MACHINE STATE")
    stat, err = get_json("/api/v1/%s/stat" % instance())
    if err:
        rep.note("unavailable (%s)" % err)
        return
    task = (stat or {}).get("task", {})
    motion = (stat or {}).get("motion", {})
    for k in ("state", "mode", "interp_state", "exec_state", "file"):
        if k in task:
            rep.kv("task." + k, task[k])
    for k in ("in_position", "motion_mode", "queue", "queue_full"):
        if k in motion:
            rep.kv("motion." + k, motion[k])
    for k in ("estop", "homed", "limit", "probe_tripped", "linear_units",
              "angular_units", "axis_mask", "joints_count", "tool_in_spindle"):
        if k in stat:
            rep.kv(k, stat[k])
    rep.text("\nFull status snapshot:")
    rep.text(json.dumps(stat, indent=2))


def sec_timing(rep):
    """Thread headroom -- the first thing to look at for a latency complaint."""
    rep.section("THREAD TIMING")
    threads, e1 = get_json("/api/v1/halcmd/threads")
    functions, e2 = get_json("/api/v1/halcmd/functions")
    if e1 or e2:
        rep.note("unavailable (%s)" % (e1 or e2))
        return
    fmap = {f.get("name"): f for f in as_list(functions)}
    for t in as_list(threads):
        period = as_int(t.get("period"))
        rep.text("\n%s  period=%d ns  fp=%s" % (t.get("name"), period, t.get("fp")))
        total = 0
        for i, fname in enumerate(t.get("functions") or [], 1):
            f = fmap.get(fname, {})
            rt = as_int(f.get("runtime"))
            total += rt
            rep.text("  %2d  %-36s %9d ns  owner=%s"
                     % (i, fname, rt, f.get("owner", "?")))
        if period:
            # Each runtime is that function's own maximum, so the sum is a
            # worst case (every function peaking in the same cycle), not an
            # observed cycle time. Labelled as such: presenting it as "% of
            # period" invites the reader to conclude the thread is overrunning
            # when it may never have.
            rep.text("  %-40s %9d ns  = %.0f%% of period if they all peaked "
                     "in one cycle"
                     % ("sum of per-function maxima", total,
                        100.0 * total / period))


def sec_update_order(rep):
    """Per signal: which thread slot services each pin on it.

    This is the one genuinely diagnostic thing the old halreport did -- it
    catches a signal read earlier in a thread than it is written, which yields
    last cycle's value. That version guessed the pin-to-function mapping from a
    hand-maintained table of pin-name patterns (funct_for_pid, funct_for_stepgen,
    funct_for_hm2, funct_for_ppmc, ... ~500 lines, with a funct_for_deprecated
    catch-all and an "UNHANDLED addf position" fallback). None of it is needed:
    HAL publishes the owning component of every pin and every function, and the
    ordered function list of every thread, so the answer is a join. Where a
    component exports several functions all of them are listed, rather than
    guessing one as the table did.
    """
    rep.section("SIGNAL UPDATE ORDER")
    pins, e1 = get_json("/api/v1/halcmd/pins")
    functions, e2 = get_json("/api/v1/halcmd/functions")
    threads, e3 = get_json("/api/v1/halcmd/threads")
    if e1 or e2 or e3:
        rep.note("unavailable (%s)" % (e1 or e2 or e3))
        return

    fowner = {f.get("name"): f.get("owner") for f in as_list(functions)}
    owner_slots = {}                    # component -> [(thread, position, funct)]
    for t in as_list(threads):
        for pos, fname in enumerate(t.get("functions") or [], 1):
            owner = fowner.get(fname)
            if owner:
                owner_slots.setdefault(owner, []).append((t.get("name"), pos, fname))

    bysig = {}
    for p in as_list(pins):
        if p.get("signal"):
            bysig.setdefault(p["signal"], []).append(p)
    if not bysig:
        rep.note("no connected signals")
        return

    rep.text("Each signal, the pins on it, and the thread slot that services "
             "each pin (via\nthe pin's owning component). A reader with a lower "
             "slot number than its writer\nsees last cycle's value.\n")
    for sig in sorted(bysig):
        rep.text("SIG %s" % sig)
        for p in sorted(bysig[sig], key=lambda x: (x.get("dir") or "", x.get("name") or "")):
            slots = owner_slots.get(p.get("owner"), [])
            where = (", ".join("%s[%d] %s" % s for s in slots) if slots
                     else "not in any thread (userspace, or function not added)")
            rep.text("    %-4s %-44s %s" % (p.get("dir"), p.get("name"), where))


def sec_hal(rep):
    """Raw HAL dump, last: verbose, and the sections above are the readable view."""
    rep.section("HAL (RAW)")
    for label, path in (("Components", "/api/v1/halcmd/components"),
                        ("Threads", "/api/v1/halcmd/threads"),
                        ("Functions", "/api/v1/halcmd/functions"),
                        ("Signals", "/api/v1/halcmd/signals"),
                        ("Pins", "/api/v1/halcmd/pins"),
                        ("Parameters", "/api/v1/halcmd/params")):
        data, e = get_json(path)
        rep.text("\n%s:" % label)
        rep.text(json.dumps(data, indent=2) if not e else "  <unavailable: %s>" % e)


def sec_logs(rep, args, tmpdir):
    rep.section("LOGS")
    # A daemonised gomc-server logs to syslog with the identifier "gomc-server"
    # (internal/daemon/syslog.go). In the foreground it writes to stdout/stderr,
    # wherever the operator redirected them, which this tool cannot know.
    out = run(["journalctl", "-t", "gomc-server", "-n", str(args.journal_lines),
               "--no-pager"], timeout=60)
    path = os.path.join(tmpdir, "gomc-server.journal")
    with open(path, "w") as f:
        f.write(out + "\n")
    rep.attach("logs/gomc-server.journal", path)
    rep.kv("journal -t gomc-server", "%d lines" % out.count("\n"))
    rep.note("empty means the server was not started with -D; in the foreground "
             "its output goes wherever the operator redirected it")

    dmesg = run(["sh", "-c", "dmesg --ctime 2>/dev/null | tail -400"], timeout=30)
    path = os.path.join(tmpdir, "dmesg.txt")
    with open(path, "w") as f:
        f.write(dmesg + "\n")
    rep.attach("logs/dmesg.txt", path)
    rep.kv("dmesg", "last 400 lines")
    rep.note("operator messages are logged here too: the server logs every "
             "operator error/message, and the live message list is WebSocket-only")


# ─── main ───

def build(args, tmpdir):
    rep = Report()
    sec_report(rep)
    sec_version(rep)
    sec_host(rep)
    up = sec_server(rep)
    sec_config(rep, args)
    if up:
        sec_machine(rep)
        sec_timing(rep)
        sec_update_order(rep)
        sec_hal(rep)
    sec_logs(rep, args, tmpdir)
    return rep


def main():
    ap = argparse.ArgumentParser(
        prog="halreport",
        description="collect one diagnostic bundle for a support question")
    ap.add_argument("-o", "--output", help="bundle path")
    ap.add_argument("--ini", help="INI file to record (default $INI_FILE_NAME)")
    ap.add_argument("--stdout", action="store_true",
                    help="write the report to stdout, make no bundle")
    ap.add_argument("--journal-lines", type=int, default=2000)
    args = ap.parse_args()

    with tempfile.TemporaryDirectory(prefix="halreport-") as tmpdir:
        rep = build(args, tmpdir)
        text = rep.render()
        if args.stdout:
            sys.stdout.write(text)
            return 0

        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        host = run(["hostname"]).strip() or "unknown"
        out = args.output or "halreport-%s-%s.tar.gz" % (host, stamp)
        base = os.path.basename(out)
        for suffix in (".tar.gz", ".tgz"):
            if base.endswith(suffix):
                base = base[:-len(suffix)]
                break
        rpath = os.path.join(tmpdir, "report.txt")
        with open(rpath, "w") as f:
            f.write(text)
        with tarfile.open(out, "w:gz") as tar:
            tar.add(rpath, arcname=base + "/report.txt")
            for name, path in sorted(rep.files.items()):
                try:
                    tar.add(path, arcname=base + "/" + name)
                except OSError as e:
                    print("halreport: skipping %s: %s" % (path, e), file=sys.stderr)
        print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
