#!/bin/bash
# Collect coverage from an instrumented run-in-place tree.
#
# Expects a tree built with COVERAGE=1 and a runtests run already done against
# it, with GOCOVERDIR pointing at a directory the Go binaries could write to.
# Produces two reports under coverage/ at the top of the tree:
#
#   coverage/c.info    C, lcov tracefile
#   coverage/go.txt    Go, "mode: atomic" text profile
#
# Both formats are ones Codecov ingests directly, and both are readable
# locally: genhtml for the first, `go tool cover -html` for the second.
#
# Usage: scripts/collect-coverage [gocoverdir]

set -euo pipefail

case "$0" in
	*/*) MYDIR="${0%/*}" ;;
	*) MYDIR="$(type -path "$0")"; MYDIR="${MYDIR%/*}" ;;
esac
TOPDIR=$(cd "$MYDIR/.." && pwd)

GOCOVERDIR_IN=${1:-${GOCOVERDIR:-}}
OUTDIR=$TOPDIR/coverage
mkdir -p "$OUTDIR"

# ---------------------------------------------------------------------------
# C
# ---------------------------------------------------------------------------
#
# lcov 2.x promotes to errors a number of things that are normal for this
# tree, so the classes below are downgraded deliberately rather than blanket
# --ignore-errors:
#
#   unused    the --exclude patterns below legitimately match nothing in a
#             partial build
#   empty     a component that no test in the selected subset ever loaded
#             yields a .gcno with no .gcda; that is a real 0%, not a failure
#   mismatch  generated cmod C is recompiled between runs; a stale .gcda that
#             no longer lines up with its .gcno should be dropped, not fatal
#   negative  counter underflow shows up under heavy threading and is a
#             known libgcov artefact, not a signal we can act on
#   inconsistent  lcov 2.x cross-checks function end lines against the source
#             and disagrees with gcc 14 on the C that modcompile generates
#             from .comp components, where one FUNCTION() body is emitted
#             inside another's line range. Observed on biquad; it is a
#             disagreement about line attribution, not bad counter data
#
# --no-external keeps /usr headers out. The excludes drop the test tree and
# the generated cmod C: the latter is real coverage, but it maps to
# objects/cmod/*.c, which is a build artefact with no counterpart in git, so
# Codecov could only report it as a file it cannot show. The hand-written C
# (HAL core, motion, interpreter, drivers) is unaffected and is the bulk.
if command -v lcov >/dev/null 2>&1; then
	echo "collect-coverage: capturing C coverage with $(lcov --version 2>&1 | head -1)"
	# Two directories, not one. The cmod components are compiled straight from
	# .c to .so in a single command with no intermediate object, so gcc names
	# their notes after the *output* and drops them in cmod/ as
	# <name>.so-<name>.gcno -- nowhere near src/. Capturing only src/ silently
	# loses every HAL component, which is most of what the suite exercises.
	lcov --capture \
		--directory "$TOPDIR/src" \
		--directory "$TOPDIR/cmod" \
		--base-directory "$TOPDIR/src" \
		--no-external \
		--ignore-errors unused,empty,mismatch,negative,inconsistent,source \
		--output-file "$OUTDIR/c.raw.info"

	# --ignore-errors source: the C that modcompile generates from .comp is an
	# intermediate, and make deletes it once the .so is linked. lcov reads
	# sources back while filtering, so those files are gone by the time it
	# looks. They are on the exclude list below anyway -- the error is lcov
	# objecting on its way to dropping them.
	lcov --remove "$OUTDIR/c.raw.info" \
		"$TOPDIR/tests/*" \
		"$TOPDIR/src/objects/*" \
		--ignore-errors unused,empty,source \
		--output-file "$OUTDIR/c.info"
	rm -f "$OUTDIR/c.raw.info"

	lcov --summary "$OUTDIR/c.info" --ignore-errors empty || true
else
	echo "collect-coverage: lcov not found, skipping C coverage" >&2
fi

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
#
# go build -cover writes one set of counter files per process. runtests starts
# stmakd once per test, so this directory holds a few hundred of them; covdata
# merges them into a single profile.
if [ -n "$GOCOVERDIR_IN" ] && [ -d "$GOCOVERDIR_IN" ]; then
	if find "$GOCOVERDIR_IN" -name 'covcounters.*' -print -quit | grep -q .; then
		echo "collect-coverage: merging Go coverage from $GOCOVERDIR_IN"
		(cd "$TOPDIR/src/stmak" && go tool covdata textfmt \
			-i="$GOCOVERDIR_IN" -o "$OUTDIR/go.txt")
		(cd "$TOPDIR/src/stmak" && go tool covdata percent -i="$GOCOVERDIR_IN") || true
	else
		echo "collect-coverage: $GOCOVERDIR_IN has no counter files." >&2
		echo "  The binaries were probably not built with COVERAGE=1, or they" >&2
		echo "  were killed with SIGKILL before the runtime could write them." >&2
		exit 1
	fi
else
	echo "collect-coverage: no GOCOVERDIR given, skipping Go coverage" >&2
fi

echo "collect-coverage: wrote $OUTDIR"
