#!/bin/sh
# file types supported: .ini, .demo

EMC_BIN_DIR=@EMC2_BIN_DIR@
if [ -x $EMC_BIN_DIR/stmakd ]; then
    EMC=$EMC_BIN_DIR/stmakd
else
    EMC=@EMC2_HOME@/bin/stmakd
fi

filename="$1"
name="$2"
comment="$3"

case ${filename##*.} in
  ini) cat <<EOF
[Desktop Entry]
Name=$name
Exec=$EMC '$filename'
Type=Application
Comment=$comment
Icon=linuxcncicon
EOF
;;
  demo) cat <<EOF
[Desktop Entry]
Name=$name
Exec=$filename
Type=Application
Comment=$comment
Icon=linuxcncicon
EOF
;;
esac
