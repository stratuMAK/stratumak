#!/bin/bash
# check-stmak-cwarnings <build-log>
#
# Fail if the captured build log contains compiler warnings in stmak-OWNED C
# code (the C we actively maintain — not the inherited 2.9 tree, which is
# expected to fade out and is not gated).  The build already compiles with
# -Wall (see Makefile.inc RTFLAGS/ULFLAGS); this turns those warnings into a
# CI failure for the owned paths only.
#
# Usage in CI:  make -O ... 2>&1 | tee build.log ; scripts/check-stmak-cwarnings build.log
set -u

LOG="${1:?usage: check-stmak-cwarnings <build-log>}"

# stmak-owned C paths (extend as ownership grows).
OWNED='stmak/internal/hallib/|stmak/pkg/cmodule/|hal/components/|cnc/motion-logger/|cnc/task/|cnc/sai/'

WARNINGS=$(grep -E ': warning:' "$LOG" | grep -E "$OWNED" || true)

if [ -n "$WARNINGS" ]; then
    echo "Compiler warnings in stmak-owned C code (gated paths: $OWNED):" >&2
    echo "$WARNINGS" >&2
    exit 1
fi
echo "check-stmak-cwarnings: no warnings in stmak-owned C code"
