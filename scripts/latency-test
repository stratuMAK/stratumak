#!/bin/bash
# latency-test - measure RT scheduling latency (gomc).
#
# Boots a minimal, standalone gomc-server (RT threads plus one `latency` cmod
# instance per thread; no INI, task or motion) and opens the web UI on it.  The
# cmod measures each thread's scheduling latency in its RT function, and a
# non-RT drainer inside it keeps the histogram, statistics and plot history
# server-side.
#
# Replaces the old halrun + timedelta + PyVCP implementation.  The command line
# (periods, suffixes, ~/.latency) is kept compatible.
#
# Copyright (C) 2026 Sascha Ittner <sascha.ittner@modusoft.de>
# License: GPL Version 2

SCRIPT_LOCATION=$(dirname "$(readlink -f "$0")")
if [ -f "$SCRIPT_LOCATION/rip-environment" ] && [ -z "$EMC2_HOME" ]; then
    . "$SCRIPT_LOCATION/rip-environment"
fi

calc()  { awk "BEGIN { print ($1); }" < /dev/null; }
icalc() { awk "BEGIN { printf \"%.0f\n\", ($1); }" < /dev/null; }

parse_time () {
    case $1 in
    -)   echo "0" ;;
    *ns) icalc "${1%ns}" ;;
    *us|*µs) icalc "1000*${1%us}" ;;
    *ms) icalc "1000*1000*${1%ms}" ;;
    *s)  icalc "1000*1000*1000*${1%s}" ;;
    *)   if [ "$1" -lt 1000 ]; then icalc "1000*$1"; else icalc "$1"; fi ;;
    esac
}

human_time () {
    if [ "$1" -eq 0 ]; then echo "-"
    elif [ "$1" -ge 1000000000 ]; then echo "$(calc "$1/1000/1000/1000")s"
    elif [ "$1" -ge 1000000 ]; then echo "$(calc "$1/1000/1000")ms"
    elif [ "$1" -ge 1000 ]; then echo "$(calc "$1/1000")µs"
    else echo "$1ns"
    fi
}

DEFAULT_SERVO=$(parse_time 1ms)

usage () {
    echo "Usage:"
    echo "       latency-test [--stress] [NAME:PERIOD ...]"
    echo "   or:"
    echo "       latency-test [--stress] [base-period [servo-period]]  # legacy"
    echo "   or:"
    echo "       latency-test [--stress] [servo-period]                # single thread"
    echo "   or:"
    echo "       latency-test -h | --help     # (this text)"
    echo ""
    echo "  --stress   load the machine while measuring, to see the effect on"
    echo "             latency: a Go garbage-collector load generator plus host"
    echo "             stress (glxgears, gzip of / to /dev/null, ping the"
    echo "             gateway).  Missing tools are skipped with an install hint."
    echo ""
    echo "Examples:"
    echo "       latency-test                       # servo-thread only, 1ms"
    echo "       latency-test servo:1ms base:25us   # named threads (shown in UI)"
    echo "       latency-test 50000 1000000         # legacy base + servo"
    echo ""
    echo "Default:      a single servo-thread with a 1ms period"
    echo ""
    echo "A NAME:PERIOD arg creates a thread NAME with that period, labelled NAME"
    echo "in the UI selector.  Bare periods use the legacy base/servo names; with"
    echo "two, the shorter is always the base-period."
    echo ""
    echo "Times may be specified with suffix \"s\", \"ms\", \"us\" \"µs\", or \"ns\""
    echo "Times without a suffix and less than 1000 are taken to be in us;"
    echo "other times without a suffix are taken to be in ns"
    echo ""
    echo "If two periods are specified then the shortest time period will"
    echo "always be the base-period"
    echo ""
    echo "The worst-case latency seen in any run of latency-test"
    echo "is written to the file ~/.latency"
    exit 1
}

# Pull the --stress flag out of the argument list; the rest are periods.
STRESS=0
POS=()
for a in "$@"; do
    case $a in
    --stress)  STRESS=1 ;;
    -h|--help) usage ;;
    -*)        echo "latency-test: unknown option $a" >&2; usage ;;
    *)         POS+=("$a") ;;
    esac
done
set -- "${POS[@]}"

# Build the thread list as "name:periodNs" specs.  Args are either NAME:PERIOD
# tokens (explicit names, shown in the UI selector) or bare periods (legacy
# base/servo names).  Default (no args) is a single 1ms servo-thread.
THREADS=()
named=0
for a in "$@"; do case $a in *:*) named=1 ;; esac; done

if [ "$named" -eq 1 ]; then
    for a in "$@"; do
        case $a in
        *:*) nm=${a%%:*}; pv=${a#*:}
             [ -n "$nm" ] && [ -n "$pv" ] || { echo "latency-test: bad NAME:PERIOD '$a'" >&2; usage; }
             THREADS+=("$nm:$(parse_time "$pv")") ;;
        *)   echo "latency-test: don't mix NAME:PERIOD and bare periods ('$a')" >&2; usage ;;
        esac
    done
else
    case $# in
    0) THREADS=("servo-thread:$DEFAULT_SERVO") ;;
    1) THREADS=("servo-thread:$(parse_time "$1")") ;;
    2) p1=$(parse_time "$1"); p2=$(parse_time "$2")
       if [ "$p1" -gt "$p2" ]; then t=$p1; p1=$p2; p2=$t; fi
       if [ "$p1" -eq "$p2" ]; then THREADS=("servo-thread:$p2")
       else THREADS=("base-thread:$p1" "servo-thread:$p2"); fi ;;
    *) usage ;;
    esac
fi

# Create threads fastest-first (rate monotonic: shortest period gets the
# highest priority), so sort the specs by period ascending.
IFS=$'\n' THREADS=($(printf '%s\n' "${THREADS[@]}" | sort -t: -k2,2n)); unset IFS

# This server is standalone and short-lived, so bind an ephemeral port instead
# of the well-known one - a running LinuxCNC already owns 5080.  An explicit
# GMC_REST_ADDR from the caller wins.
if [ -n "$GMC_REST_ADDR" ]; then
    ADDR="$GMC_REST_ADDR"
else
    PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()' 2>/dev/null)
    [ -n "$PORT" ] || PORT=5081
    ADDR="127.0.0.1:$PORT"
fi
BASE_URL="http://$ADDR"

T=$(mktemp -d)
SRV_PID=""
STRESS_PIDS=()   # process-group leaders of the external stressors
cleanup () {
    # Stop the external stressors first.  Each was started with setsid, so the
    # PID is a process-group leader and a negative-PID kill reaps the whole
    # pipeline (find/xargs/gzip children), not just the launcher.
    for p in "${STRESS_PIDS[@]}"; do
        kill -TERM -- -"$p" 2>/dev/null
    done
    if [ -n "$SRV_PID" ]; then
        kill -INT "$SRV_PID" 2>/dev/null
        wait "$SRV_PID" 2>/dev/null
    fi
    cd /; [ -d "$T" ] && rm -rf "$T"
}
trap cleanup SIGINT SIGTERM EXIT

# ---- external host stress (--stress) --------------------------------------
# Reproduces the old "abuse the computer while testing" advice automatically.
# Each stressor runs in its own session so cleanup() can kill its whole group;
# missing tools are reported with an install hint and skipped, never fatal.

have_tool () {  # have_tool <cmd> <apt-package>
    command -v "$1" >/dev/null 2>&1 && return 0
    echo "latency-test: '$1' not found - skipping its stress (install: sudo apt install $2)" >&2
    return 1
}

start_stressor () {  # start_stressor <shell-command>
    # Run in a new session so the whole pipeline can be killed as one group.
    # The child writes its OWN pid to a file: that pid IS the process-group id
    # (a session leader leads its group).  We must not use $! here - setsid
    # forks when it is already a group leader, so $! can be a short-lived parent
    # while the real group runs elsewhere, and killing $! would leak the tree.
    local pf; pf="$T/pgid.${#STRESS_PIDS[@]}"
    setsid bash -c 'echo $$ >"'"$pf"'"; '"$1" >/dev/null 2>&1 &
    local i
    for i in $(seq 1 25); do [ -s "$pf" ] && break; sleep 0.02; done
    local pg; pg=$(cat "$pf" 2>/dev/null); rm -f "$pf"
    [ -n "$pg" ] && STRESS_PIDS+=("$pg")
}

start_external_stress () {
    echo "latency-test: starting host stress (glxgears, gzip, ping)" >&2

    # GPU / compositor: a few spinning gears.  Needs an X display (present in
    # the graphical session this is launched from).
    if [ -z "$DISPLAY" ]; then
        echo "latency-test: no DISPLAY - skipping glxgears" >&2
    elif have_tool glxgears mesa-utils; then
        for _ in 1 2 3 4; do start_stressor 'exec glxgears'; done
    fi

    # Disk I/O + CPU + process churn: compress every regular readable file to
    # /dev/null, in a loop.  -exec ... {} \; restarts gzip once PER FILE (a
    # fresh fork+exec each time), which loads the scheduler harder than piping
    # batches through one gzip; run one loop per core for parallel load.  Prune
    # the pseudo-filesystems: reading e.g. /proc/kcore is all of RAM and some
    # /proc,/sys files block forever.
    if have_tool gzip gzip && have_tool find findutils; then
        P=$(nproc 2>/dev/null || echo 4); [ "$P" -gt 4 ] && P=4
        i=0
        while [ "$i" -lt "$P" ]; do
            start_stressor 'while :; do
                find / -path /proc -prune -o -path /sys -prune -o -path /dev -prune \
                       -o -path /run -prune -o -type f -readable \
                       -exec gzip -c {} \; >/dev/null 2>&1
            done'
            i=$((i + 1))
        done
    fi

    # Network + softirq: rapid ping to the default gateway.  -i 0.01 needs
    # cap_net_raw; we never use sudo, so if the kernel rejects the interval the
    # ping just exits and we say so.
    if have_tool ping iputils-ping && have_tool ip iproute2; then
        gw=$(ip route show default 2>/dev/null | awk '/default/{print $3; exit}')
        if [ -z "$gw" ]; then
            echo "latency-test: no default gateway - skipping ping" >&2
        else
            start_stressor "exec ping -i 0.01 -q '$gw'"
            sleep 0.4
            kill -0 "${STRESS_PIDS[-1]}" 2>/dev/null || \
                echo "latency-test: 'ping -i 0.01 $gw' exited (needs cap_net_raw; no sudo used) - ping skipped" >&2
        fi
    fi
}

# One latency instance per thread.  The instance is loaded as `lat.<name>`
# (the loader's angle-bracket name), addf'd to its thread, and carries an
# explicit label=<name> so the UI selector shows a readable name without
# inferring it from HAL thread topology.  The instance is prefixed (lat.) so it
# never collides with the thread's own `.time` param.
{
    for spec in "${THREADS[@]}"; do
        echo "newthread ${spec%%:*} ${spec#*:}"
    done
    for spec in "${THREADS[@]}"; do
        nm=${spec%%:*}
        echo "loadrt latency <lat.$nm> label=$nm"
        echo "addf lat.$nm $nm"
    done
    # --stress: load the GC-pressure generator so the run is measured under
    # Go garbage-collector load (default workers/live set by the module).
    [ "$STRESS" -eq 1 ] && echo "loadrt stress_gc"
    echo "start"
} > "$T/latency.hal"

# Stream the server's stdout+stderr both to a log file (read back below) and
# live to our own stderr, so a mid-run crash - panic, stack trace - is visible
# instead of being lost when cleanup() removes the temp dir.
GMC_REST_ADDR="$ADDR" gomc-server -f "$T/latency.hal" -serve \
    > >(tee "$T/server.log" >&2) 2>&1 &
SRV_PID=$!

# Wait for the REST API before opening the viewer.
started=0
for _ in $(seq 1 100); do
    if curl -sf -o /dev/null "$BASE_URL/api/v1/_registry" 2>/dev/null; then
        started=1; break
    fi
    if ! kill -0 "$SRV_PID" 2>/dev/null; then break; fi
    sleep 0.1
done
if [ "$started" -ne 1 ]; then
    echo "latency-test: gomc-server failed to start (see server log above)" >&2
    exit 1
fi

# --stress also loads the whole machine, not just the Go runtime.
[ "$STRESS" -eq 1 ] && start_external_stress

# The viewer blocks until its window is closed.  Closing it (or Ctrl+C /
# SIGTERM) fires cleanup(), which stops the stressors and the server.
GMC_REST_URL="$BASE_URL" latency

# Record this run's worst-case jitter, keeping the worst ever seen: ~/.latency
# is what the docs and other tools read.
worst=0
for spec in "${THREADS[@]}"; do
    inst="lat.${spec%%:*}"
    j=$(curl -sf "$BASE_URL/api/v1/$inst/status" 2>/dev/null |
        sed -n 's/.*"maxJitterNs":\([0-9]*\).*/\1/p')
    if [ -n "$j" ] && [ "$j" -gt "$worst" ] 2>/dev/null; then worst=$j; fi
done
if [ "$worst" -gt 0 ] 2>/dev/null; then
    prev=$(cat "$HOME/.latency" 2>/dev/null)
    case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
    if [ "$worst" -gt "$prev" ]; then echo "$worst" > "$HOME/.latency"; fi
    echo "Worst-case jitter this run: ${worst}ns (worst ever: $(cat "$HOME/.latency"))"
fi
