# LinuxCNC infrastructure modules.
# Include as first HALFILE to load the CNC stack.
# Order matters: later modules depend on APIs registered by earlier ones.

load tpmod
# Per-joint homing modules: one instance per joint.
# Uses [JOINT_n]HOMEMOD from INI (default: "homemod").
{{- range $j := seq 0 .Joints}}
{{- $mod := or (ini (printf "JOINT_%d" $j) "HOMEMOD") "homemod"}}
load {{$mod}} <homemod.{{$j}}>
{{- end}}
load io <iocontrol>
load persist_sqlite <persistence>
load tooltable
# A config with a server-side pyvcp panel names its instance via
# [TASK]PYVCP_INSTANCE so milltask reports it over GET /info (the panel is a
# milltask load parameter by design; this only fills it in, same as HOMEMOD
# above). Unset = no panel.
load milltask halui=halui{{with ini "TASK" "PYVCP_INSTANCE"}} pyvcp_instance={{.}}{{end}}

# load UI helper
load ngcpreview
load halscope

