namespace eval linuxcnc {
    variable HOME @EMC2_HOME@
    variable BIN_DIR @EMC2_BIN_DIR@
    variable TCL_DIR @EMC2_TCL_DIR@
    variable TCL_LIB_DIR @EMC2_TCL_LIB_DIR@
    variable TCL_BIN_DIR @EMC2_TCL_DIR@/bin
    variable TCL_SCRIPT_DIR @EMC2_TCL_DIR@/scripts
    variable HELP_DIR @EMC2_HELP_DIR@
    variable RTLIB_DIR @EMC2_RTLIB_DIR@
    variable CONFIG_PATH {@LINUXCNC_CONFIG_PATH@}
    variable NCFILES_DIR @EMC2_NCFILES_DIR@
    variable LANG_DIR @EMC2_LANG_DIR@
    variable IMAGEDIR @EMC2_IMAGE_DIR@
    variable REALTIME @REALTIME@
    variable RTS @RTS@
    variable CONFIG_DIR {}
    foreach _dir  [split {@LINUXCNC_CONFIG_PATH@} :] {
	lappend CONFIG_DIR [file normalize $_dir]
    }
    unset _dir
    variable USER_CONFIG_DIR [lindex $CONFIG_DIR 0]
    variable _langinit 1
    variable LINUXCNC_AUX_GLADEVCP @LINUXCNC_AUX_GLADEVCP@
    variable LINUXCNC_AUX_EXAMPLES @LINUXCNC_AUX_EXAMPLES@
}

if {[string first $::linuxcnc::BIN_DIR: $env(PATH)] != 0} {
    set env(PATH) $::linuxcnc::BIN_DIR:$env(PATH)
}

proc linuxcnc::image_search i {
    set paths "$linuxcnc::IMAGEDIR $linuxcnc::HOME $linuxcnc::HOME/etc/linuxcnc /etc/linuxcnc ."
    foreach f $paths {
        if [file exists $f/$i] {
            return [image create photo -file $f/$i]
        }
        if [file exists $f/$i.gif] {
            return [image create photo -file $f/$i.gif]
        }
    }
    error "image $i is not available"
}

# NML Tcl extension removed — commands now handled via gomc-server
# load [file join [file dirname [info script]] linuxcnc[info sharedlibextension]]

# The removed extension was what satisfied `package require Linuxcnc`: emcsh.cc
# called Tcl_PkgProvide, and nothing in this file ever did. Commenting out the
# load therefore made every `package require Linuxcnc` fail — quietly, because
# the ifneeded script has already sourced this file by then, so the namespace
# and procs below exist and only callers that check the require notice (ngcgui
# reports "Internationalization not available" and runs on without msgcat).
package provide Linuxcnc 1.0

# Arrange to load hal.so when the 'hal' command is requested
proc hal {args} {
    load $::linuxcnc::TCL_LIB_DIR/hal.so
    eval hal $args
}

# ---------------------------------------------------------------------------
# Controller status over REST
#
# Replaces the handful of emcsh commands Tcl code still wanted after the NML
# removal. One-shot GET /stat over Tcl's core http package — no tcllib: the
# json package is not a dependency of this project and is absent on the
# reference system, so the few fields needed are pulled out directly. That is
# only safe because they are *flat* objects at the top level of the snapshot;
# do not grow this into a general JSON reader, use a real parser instead.
# ---------------------------------------------------------------------------

proc linuxcnc::rest_url {} {
    if {[info exists ::env(GMC_REST_URL)] && $::env(GMC_REST_URL) ne ""} {
        return [string trimright $::env(GMC_REST_URL) /]
    }
    return "http://127.0.0.1:5080"
}

proc linuxcnc::instance {} {
    if {[info exists ::env(GMC_INSTANCE)] && $::env(GMC_INSTANCE) ne ""} {
        return $::env(GMC_INSTANCE)
    }
    return "milltask"
}

# Fetch the status snapshot as raw JSON text. Errors if the controller is not
# reachable or answers anything but 200 — callers decide whether that is fatal.
proc linuxcnc::stat_json {} {
    package require http
    set url "[linuxcnc::rest_url]/api/v1/[linuxcnc::instance]/stat"
    set tok [http::geturl $url -timeout 2000]
    try {
        if {[http::status $tok] ne "ok"} {
            error "GET $url: [http::status $tok] [http::error $tok]"
        }
        if {[http::ncode $tok] != 200} {
            error "GET $url: HTTP [http::ncode $tok]"
        }
        return [http::data $tok]
    } finally {
        http::cleanup $tok
    }
}

# Numeric field of a flat top-level JSON object, e.g. the "x" of
# "actual_position": {"x": 1.5, "y": ...}. The leading quote in the pattern is
# what keeps "actual_position" from also matching inside
# "joint_actual_position".
proc linuxcnc::_json_axis {json object axis} {
    if {![regexp "\"$object\"\\s*:\\s*(\{\[^\{\}\]*\})" $json -> obj]} {
        error "status field $object not found"
    }
    if {![regexp "\"$axis\"\\s*:\\s*(-?\[0-9.eE+-\]+)" $obj -> value]} {
        error "status field $object.$axis not found"
    }
    return $value
}

# Actual position in the *relative* (program) coordinate system, for one axis
# letter — the replacement for emcsh's emc_rel_act_pos.
#
# Parity with 2.9 (shcom.cc convertLinearUnits / emcsh.cc emc_rel_act_pos):
# actual position less the g5x, g92 and tool offsets, reported in the units the
# *program* is in (G20/G21), which is what a value typed into a G-code
# parameter field has to be. gomc's wire format is mm, so unlike 2.9 there is
# no machine-units step first. Angular axes are degrees throughout —
# convertAngularUnits was the identity in 2.9 too.
proc linuxcnc::rel_act_pos {axis} {
    set axis [string tolower $axis]
    if {[lsearch -exact {x y z a b c u v w} $axis] < 0} {
        error "rel_act_pos: bad coordinate letter <$axis>"
    }
    set json [linuxcnc::stat_json]
    set v [linuxcnc::_json_axis $json actual_position $axis]
    foreach off {g5x_offset g92_offset tool_offset} {
        set v [expr {$v - [linuxcnc::_json_axis $json $off $axis]}]
    }
    if {[lsearch -exact {a b c} $axis] >= 0} {
        return $v
    }
    # 1 = inch, 2 = mm, 3 = cm (canon length units, emcstat.gmi)
    if {![regexp {"program_units"\s*:\s*([0-9]+)} $json -> units]} {
        set units 2
    }
    switch -- $units {
        1       {return [expr {$v / 25.4}]}
        3       {return [expr {$v / 10.0}]}
        default {return $v}
    }
}

# Internationalisation (i18n)
# in order to use i18n, all the strings will be called [msgcat::mc "string-foo"]
# instead of "string-foo".
# Thus msgcat searches for a translation of the string, and in case one isn't 
# found, the original string is used.
# In order to properly use locale's the env variable LANG is queried.
# If LANG is defined, then the folder src/po is searched for files
# called *.msg, (e.g. en_US.msg).
package require msgcat
if {$linuxcnc::_langinit && [info exists env(LANG)]} {
    msgcat::mclocale
    msgcat::mcload $linuxcnc::LANG_DIR
    set linuxcnc::_langinit 0
}

proc linuxcnc::standard_font_size {} {
    if {[info exists ::linuxcnc::standard_font_size]} { return $::linuxcnc::standard_font_size }
    set res1 [catch {exec gconftool -g /desktop/gnome/font_rendering/dpi} gnome_dpi]
    set res2 [catch {exec xlsfonts -fn -adobe-helvetica-medium-r-normal--*-*-*-*-p-*-iso10646-1} fonts]
    if {$res1 == 0 && $res2 == 0} {
        set pixels [expr {$gnome_dpi / 8.}]
        set min_diff [expr .2*$pixels]
        set best_size [expr {int($pixels)}]
        foreach f $fonts {
            regexp -- {-.*?-.*?-.*?-.*?-.*?-.*?-(.*?)-.*} $f _ sz
            set diff [expr {abs($pixels - $sz)}]
            if {$diff < $min_diff} {
                set min_diff $diff
                set best_size $sz
            }
        }
        return -$best_size
        set ::linuxcnc::standard_font_size -$best_size
    } else {
        set ::linuxcnc::standard_font_size 12
    }
}

proc linuxcnc::standard_font_family {} {
    if {[lsearch [font names] TkDefaultFont] != -1} {
	return [font configure TkDefaultFont -family]
    }
    return Helvetica
}

proc linuxcnc::standard_font {} {
    if {[lsearch [font names] TkDefaultFont] != -1} { return TkDefaultFont }
    list [standard_font_family] [standard_font_size]
}

proc linuxcnc::standard_fixed_font_family {} {
    if {[lsearch [font names] TkFixedFont] != -1} {
	return [font configure TkFixedFont -family]
    }
    return Courier
}

proc linuxcnc::standard_fixed_font {} {
    if {[lsearch [font names] TkFixedFont] != -1} { return TkFixedFont }
    set sz [standard_font_size]
    if {$sz < 0 && $sz >= -12 && [lsearch [font families] fixed] != -1} {
        return fixed
    }
    list [standard_fixed_font_family] [standard_font_size]
}

proc parse_ini {filename} {
    # create associative arrays for all ini file sections
    # like: ::EMC(VERSION), ::KINS(JOINTS), ... etc
    set f [open $filename]

    while {[gets $f line] >= 0} {
        set line [string trim $line]
        if {[regexp {^\[(.*)\]\s*$} $line _ section]} {
            # nothing
        } elseif {[regexp {^([^#]+?)\s*=\s*(.*?)\s*$} $line _  k v]} {
            upvar $section s
            lappend s([string trim $k]) $v
        }
    }

    close $f
}
