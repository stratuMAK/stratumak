// Runtest component for fsm blocks: every behaviour of the execution model
// in docs/dev/MODCOMPILE_FSM_DESIGN.md shows up on a pin, so the captured
// samples are the model cycle by cycle.
component fsm_test "fsm block runtest";

pin in bit go;
pin in bit abort;
pin in bit ack;
pin in bit rst;
pin in bit en;

pin out s32 state;
pin out float t;
pin out bit entered "on_enter pulse, any state";
pin out bit exited "on_exit pulse of RUN";
pin out bit acted "transition action pulse";
pin out bit busy "held by RUN's during";
pin out s32 runs "latched: entries into RUN since reset";

param rw float delay = 0.0035;

function _;

fsm seq {
    inputs:    go, abort, ack;
    outputs:   entered, exited, acted, busy;
    latched:   runs;
    reset:     (rst);
    enable:    (en);
    state_var: state;
    timer_var: t;

    any {
        on (abort) -> FAULT { acted = 1; }
    }

    state IDLE {
        on_enter { entered = 1; }
        on (go) -> RUN { acted = 1; }
    }

    state RUN {
        on_enter { entered = 1; runs++; }
        on_exit  { exited = 1; }
        during   { busy = 1; }
        on (!go) -> IDLE;
        timeout (delay) -> DONE;
    }

    state DONE {
        on_enter { entered = 1; }
        on (!go) -> IDLE;
        on (ack) -> DONE;
    }

    state FAULT {
        on_enter { entered = 1; }
        on (!abort && ack) -> IDLE;
    }
};

;;

seq();
