#!/bin/bash
# Columns: sr_q rs_q rise fall cu_cv cd_cv, one line per cycle, against the
# clk/aux pattern in test.sh.
#
# The diff catches any change at all.  The assertions after it name which
# property of IEC's own block bodies broke, because "line 7 column 2 differs"
# is a poor way to learn that reset-dominance stopped working.
here=$(dirname "$0")
diff -u "$here/expected" "$1" || exit 1

fail() { echo "$1"; exit 1; }

col() { awk -v r="$1" -v c="$2" 'NR==r {print $c}' "$3"; }

# 1. No edge on the first cycle.  An instance loads with its members zeroed,
#    so an F_TRIG whose M does not start true reports a falling edge that
#    never happened -- which is why IEC initialises it.
[ "$(col 1 4 "$1")" = "0" ] || fail 'F_TRIG reported a falling edge on the first cycle; its M must start true'
[ "$(col 1 3 "$1")" = "0" ] || fail 'R_TRIG reported a rising edge on the first cycle'

# 2. An edge output lasts exactly one cycle.  clk is high on cycles 2 and 3.
[ "$(col 2 3 "$1")" = "1" ] || fail 'R_TRIG missed the rising edge on cycle 2'
[ "$(col 3 3 "$1")" = "0" ] || fail 'R_TRIG held its output past one cycle'
[ "$(col 4 4 "$1")" = "1" ] || fail 'F_TRIG missed the falling edge on cycle 4'

# 3. Cycle 7 has both inputs true, which is the only thing that tells the two
#    latches apart: SR is set-dominant, RS is reset-dominant.
[ "$(col 7 1 "$1")" = "1" ] || fail 'SR is not set-dominant: with both inputs true Q1 must be true'
[ "$(col 7 2 "$1")" = "0" ] || fail 'RS is not reset-dominant: with both inputs true Q1 must be false'

# 4. A counter counts edges, not levels: clk is high for cycles 2 and 3 and
#    the count moves once.
[ "$(col 2 5 "$1")" = "1" ] || fail 'CTU did not count the first edge'
[ "$(col 3 5 "$1")" = "1" ] || fail 'CTU counted a level rather than an edge'
[ "$(col 5 5 "$1")" = "2" ] || fail 'CTU did not count the second edge'

# 5. R clears the count and LD loads it, both on cycle 7.
[ "$(col 7 5 "$1")" = "0" ] || fail 'CTU did not reset on R'
[ "$(col 7 6 "$1")" = "3" ] || fail 'CTD did not load PV on LD'
