newthread servo 1000000

load fsm_multi <fsmm>
load filestream stream_cfg=bbbf sample_cfg=bbbfsssssb infile=input-signals outfile=out.txt depth=100 samples=20

net trig  filestream.stream.0 => fsmm.trig  filestream.sample.0
net go    filestream.stream.1 => fsmm.go    filestream.sample.1
net sel   filestream.stream.2 => fsmm.sel   filestream.sample.2
net to-ms filestream.stream.3 => fsmm.to-ms filestream.sample.3

net astate fsmm.astate => filestream.sample.4
net code   fsmm.code   => filestream.sample.5
net via    fsmm.via    => filestream.sample.6
net cnt    fsmm.cnt    => filestream.sample.7
net bstate fsmm.bstate => filestream.sample.8
net wname  fsmm.wname  => filestream.sample.9

addf filestream.write servo
addf fsmm servo
addf filestream.read  servo
