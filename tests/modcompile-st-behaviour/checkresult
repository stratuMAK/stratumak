#!/bin/bash
# The captured columns come in pairs -- the .comp result, then the .st one.
#
# Two checks, because either alone is weak.  The diff catches a change in
# behaviour; the pairwise comparison catches a change that altered both
# frontends the same way and so still matches a stale expected file.
here=$(dirname "$0")

diff -u "$here/expected" "$1" || exit 1

awk '{
    for (i = 1; i <= NF; i += 2) {
        if ($i != $(i+1)) {
            printf "line %d: column %d differs: .comp=%s .st=%s\n", NR, i, $i, $(i+1)
            bad = 1
        }
    }
} END { exit bad }' "$1"
