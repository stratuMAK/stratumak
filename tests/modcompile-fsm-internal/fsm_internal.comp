// Runtest component for the internal on: 'on (cond) { action }' without a
// target runs its action and stays in the state, and as the match of the
// run it holds back the items after it, the timeout included, while the
// timer runs on.  input-signals says what each cycle checks.
component fsm_internal "fsm block runtest, internal on";

pin in bit go "enable";
pin in bit trig;
pin in bit hold;
pin out s32 code "output, default 7; set by the output blocks";
pin out u32 nent "latched: entries into B";
pin out u32 nhold "latched: runs of B's internal on";
pin out float tv "timer_var";

function _;

fsm m {
    inputs:    trig, hold;
    outputs:   code = 7;
    latched:   nent, nhold;
    timer_var: tv;
    enable:    (go);

    state A {
        output { code = 1; }
        on (trig) -> B;
    }

    state B {
        on_enter { nent++; }
        output   { code = 2; }
        on (hold) { nhold++; }
        on (!trig) -> A;
        timeout (3ms) -> C;
    }

    state C {
        output { code = 3; }
        on (!trig) -> A;
    }
};

;;

m();
