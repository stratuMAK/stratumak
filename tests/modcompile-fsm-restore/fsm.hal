newthread servo 1000000

# r0 and r1 share the io signal st, set before the first cycle like a
# retained signal: both are restored in B.  Afterwards each run's write is a
# write from outside for the other, which has no effect.  r2's st2 holds a
# value that is no state: r2 starts in the initial state.
load fsm_restore <r0,r1,r2>
load filestream stream_cfg=bbbbb sample_cfg=bbbbbsssfsuusu infile=input-signals outfile=out.txt depth=100 samples=16

net go   filestream.stream.0 => r0.go  r2.go  filestream.sample.0
net go1  filestream.stream.1 => r1.go         filestream.sample.1
net rst  filestream.stream.2 => r0.rst r1.rst r2.rst filestream.sample.2
net trig filestream.stream.3 => r0.trig r1.trig r2.trig filestream.sample.3
net clr  filestream.stream.4 => r0.clr r1.clr r2.clr filestream.sample.4

net code  r0.code => filestream.sample.5
net ndur  r0.ndur => filestream.sample.6
net nent  r0.nent => filestream.sample.7
net tv    r0.tv   => filestream.sample.8
net code1 r1.code => filestream.sample.9
net st    r0.st r1.st filestream.sample.10
net st2   r2.st filestream.sample.11
net code2 r2.code => filestream.sample.12
net mdl   r0.model filestream.sample.13

sets st  1
sets st2 9
sets mdl 20

addf filestream.write servo
addf r0 servo
addf r1 servo
addf r2 servo
addf filestream.read  servo
