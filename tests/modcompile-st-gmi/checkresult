#!/bin/bash
# Columns: what the consumer read back across the interface (homing, homed,
# idle), then the provider's own state (homing, homed, calls).
#
# Deterministic: nothing here is timed, every value follows from the calls the
# consumer made.  So the diff can be exact, and the assertions after it name
# which end of the interface broke.
#
# The provider's pins lag the consumer's reads by one cycle throughout, and
# that is not an error: the provider's body runs before the consumer's in the
# thread, so it publishes the state it had before this cycle's calls arrived.
here=$(dirname "$0")
diff -u "$here/expected" "$1" || exit 1

fail() { echo "$1"; exit 1; }
col() { awk -v r="$1" -v c="$2" 'NR==r {print $c}' "$3"; }

# Nothing has been asked for yet.
[ "$(col 1 1 "$1")" = "0" ] || fail 'the consumer read homing before anything was started'
[ "$(col 1 2 "$1")" = "0" ] || fail 'the consumer read homed before anything was started'

# A value coming back through the interface.  get_is_idle returns a constant
# 1 from the provider, so reading 1 here means the call arrived, reached the
# provider's method, and the result came back.
[ "$(col 1 3 "$1")" = "1" ] || fail 'get_is_idle did not return the providers value; the call is not arriving'

# start rises on cycle 2, so do_home() runs and the provider goes to homing.
# The consumer reads that back in the same cycle, through get_homing().
[ "$(col 2 1 "$1")" = "1" ] || fail 'do_home() did not reach the provider, or get_homing() did not read it back'
# ...and the provider's own pin shows it a cycle later, since its body ran
# before the call did.
[ "$(col 3 4 "$1")" = "1" ] || fail 'the provider is not in the state the consumer read'

# step rises on cycle 4: one do_homing() moves it from homing to homed.
[ "$(col 4 1 "$1")" = "0" ] || fail 'do_homing() left the provider still homing'
[ "$(col 4 2 "$1")" = "1" ] || fail 'do_homing() did not reach homed'
[ "$(col 5 5 "$1")" = "1" ] || fail 'the providers own homed flag disagrees with what the consumer read'

# A second do_homing() on cycle 6 must do nothing, because it is already
# homed -- which is the providers logic running, not the consumers.
[ "$(col 6 2 "$1")" = "1" ] || fail 'a second do_homing() disturbed a provider that was already homed'

# read_in_pins() is called every cycle and counts on the provider side, so the
# count rising by one a cycle is the interface being crossed each time.
first=$(col 3 6 "$1")
last=$(col 10 6 "$1")
[ "$last" -gt "$first" ] || fail "the providers call count did not rise: $first then $last"
[ $((last - first)) -eq 7 ] || fail "the call count rose by $((last - first)) over 7 cycles, want 7"
