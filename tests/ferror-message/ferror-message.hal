load [KINS]KINEMATICS
load [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

addf motion-command-handler servo-thread
addf motion-controller servo-thread

# Joint 0's feedback is deliberately left unlinked so the test can drive it
# with halcmd setp and open a following error without commanding any motion.
net j1pos joint.1.motor-pos-cmd => joint.1.motor-pos-fb
net j2pos joint.2.motor-pos-cmd => joint.2.motor-pos-fb

net estop-out <= iocontrol.user-enable-out
net estop-out => iocontrol.emc-enable-in
