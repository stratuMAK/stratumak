# CoE mailbox slave for the link-loss / rescan test. A companion
# "bus.sim.link" control file (written by test.sh) drives the sim link state:
# content "0" drops the link, "1" restores it.
slave 0
  vendor   0x00000E17
  product  0x51340001
  revision 0x00010000
  serial   1
  mbox_out 0x1000 128
  mbox_in  0x1080 128
  sm2      0x1100 8
  sm3      0x1400 8
  od       0x1600 0 1 0
  od       0x1a00 0 1 0
