<!--
  stmak EtherCAT integration test config: two slaves on the simulated bus
  (see bus.sim), but only slave 0 is configured here. Slave 1 is deliberately
  left out so that it stays in PRE-OP for the whole run. Never a production
  config.
-->
<masters>
  <master idx="0" interface="bus.sim" transportType="sim" appTimePeriod="1000000">
    <slave idx="0" type="generic" vid="00000E17" pid="51340001" configPdos="true" name="io">
      <syncManager idx="2" dir="out">
        <pdo idx="1600">
          <pdoEntry idx="7000" subIdx="01" bitLen="8" halPin="dout" halType="u32"/>
        </pdo>
      </syncManager>
      <syncManager idx="3" dir="in">
        <pdo idx="1a00">
          <pdoEntry idx="6000" subIdx="01" bitLen="8" halPin="din" halType="u32"/>
        </pdo>
      </syncManager>
    </slave>
  </master>
</masters>
