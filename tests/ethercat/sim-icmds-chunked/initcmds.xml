<?xml version="1.0" encoding="UTF-8"?>
<!-- Regression fixture for the CoE <initCmds> parser.

     The <Data> of the 0x2000 command below is positioned so that it spans the
     parser's BUFFSIZE (8192 byte) read boundary with an ODD number of hex
     digits before the split.  Expat then delivers the node in two chunks that
     break in the middle of a byte.  parse_data() must carry that half byte
     across the chunks; before it did, this file failed with "Invalid data".

     The padding comment below is sized by tests/ethercat/sim-icmds-chunked/gen.py
     semantics: do not reflow this file, or the split moves and the test stops
     testing anything.  Verify with the assertion in test.sh. -->
<!---->
<EtherCATMailbox><CoE><InitCmds>
	<InitCmd>
		<Transition>SO</Transition>
		<Comment><![CDATA[transition accepted and ignored]]></Comment>
		<Index>8196</Index>
		<SubIndex>0</SubIndex>
		<Data>44444444</Data>
	</InitCmd>
	<InitCmd CompleteAccess="true">
		<Comment><![CDATA[CompleteAccess spelled the TwinCAT way]]></Comment>
		<Index>8194</Index>
		<SubIndex>0</SubIndex>
		<Data>22222222</Data>
	</InitCmd>
	<InitCmd>
		<Comment><![CDATA[Data node straddling the read boundary]]></Comment>
		<Index>8192</Index>
		<SubIndex>0</SubIndex>
		<Data>44332211</Data>
	</InitCmd>
</InitCmds></CoE></EtherCATMailbox>
