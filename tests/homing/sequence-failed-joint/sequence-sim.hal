# Kinematics + motion controller + two simulated CiA 402 drives.
# linuxcnc.hal has already loaded homemod_cia402 <homemod.0>, <homemod.1> (from
# [JOINT_n]HOMEMOD), io, milltask, etc.; threads.hal created servo-thread.

load [KINS]KINEMATICS
load [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
load sim_cia402_drive <simdrv.0,simdrv.1>

addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf simdrv.0 servo-thread
addf simdrv.1 servo-thread

net j0-pos-cmd joint.0.motor-pos-cmd => simdrv.0.pos-cmd
net j0-pos-fb  simdrv.0.pos-fb       => joint.0.motor-pos-fb
net j0-opmode-cmd homemod.0.opmode-cmd      => simdrv.0.opmode-cmd
net j0-opmode-fb  simdrv.0.opmode-fb        => homemod.0.opmode-fb
net j0-home-cmd   homemod.0.home-cmd        => simdrv.0.home-cmd
net j0-attained   simdrv.0.homing-attained  => homemod.0.homing-attained
net j0-home-err   simdrv.0.homing-error     => homemod.0.homing-error

net j1-pos-cmd joint.1.motor-pos-cmd => simdrv.1.pos-cmd
net j1-pos-fb  simdrv.1.pos-fb       => joint.1.motor-pos-fb
net j1-opmode-cmd homemod.1.opmode-cmd      => simdrv.1.opmode-cmd
net j1-opmode-fb  simdrv.1.opmode-fb        => homemod.1.opmode-fb
net j1-home-cmd   homemod.1.home-cmd        => simdrv.1.home-cmd
net j1-attained   simdrv.1.homing-attained  => homemod.1.homing-attained
# Joint 1's homing error is the test's to raise (sets j1-home-err 1): the
# drive reports a failed homing with no drive fault.
net j1-home-err   => homemod.1.homing-error

# estop + tool-change loopbacks (as in core_sim.hal) so milltask can enable.
net estop-loop      iocontrol.user-enable-out iocontrol.emc-enable-in
net tool-prep-loop  iocontrol.tool-prepare    iocontrol.tool-prepared
net tool-change-loop iocontrol.tool-change    iocontrol.tool-changed
