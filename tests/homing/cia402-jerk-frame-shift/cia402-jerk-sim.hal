# Kinematics + motion controller + the simulated CiA 402 drive + watchdog.
# linuxcnc.hal has already loaded homemod_cia402 <homemod.0> (from
# [JOINT_0]HOMEMOD), io, milltask, etc.; threads.hal created servo-thread.

load [KINS]KINEMATICS
load [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
load sim_cia402_drive <simdrv.0>
load pos_excursion_watch <watch.0>

# Servo-thread functions. The sim drive runs AFTER motmod each cycle: it reads
# motmod's motor-pos-cmd / homemod's opmode-cmd and produces the feedback motmod
# reads next cycle. The watchdog observes the drive feedback.
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf simdrv.0 servo-thread
addf watch.0 servo-thread

# Joint 0 CSP position path: motmod <-> sim drive.
net j0-pos-cmd joint.0.motor-pos-cmd => simdrv.0.pos-cmd
net j0-pos-fb  simdrv.0.pos-fb       => joint.0.motor-pos-fb watch.0.in

# Drive-internal homing handshake: homemod_cia402 <-> sim drive.
net j0-opmode-cmd homemod.0.opmode-cmd      => simdrv.0.opmode-cmd
net j0-opmode-fb  simdrv.0.opmode-fb        => homemod.0.opmode-fb
net j0-home-cmd   homemod.0.home-cmd        => simdrv.0.home-cmd
net j0-attained   simdrv.0.homing-attained  => homemod.0.homing-attained watch.0.enable
net j0-home-err   simdrv.0.homing-error     => homemod.0.homing-error

# estop + tool-change loopbacks (as in core_sim.hal) so milltask can enable.
net estop-loop      iocontrol.user-enable-out iocontrol.emc-enable-in
net tool-prep-loop  iocontrol.tool-prepare    iocontrol.tool-prepared
net tool-change-loop iocontrol.tool-change    iocontrol.tool-changed

# Servo-thread records for the test: how far the drive feedback travelled
# (the seek lasts ~200 ms, too short to catch by polling status) and whether
# the joint ever latched a following error (f-errored as a float, so minmax
# keeps 1 once it was ever TRUE).
load minmax <seek.0>
load conv_bit_float <ferr.0>
load minmax <ferrmax.0>
addf seek.0    servo-thread
addf ferr.0    servo-thread
addf ferrmax.0 servo-thread
net j0-pos-fb => seek.0.in
net j0-ferr   joint.0.f-errored => ferr.0.in
net j0-ferr-f ferr.0.out        => ferrmax.0.in
