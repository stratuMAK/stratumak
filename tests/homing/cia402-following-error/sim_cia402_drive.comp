component sim_cia402_drive """Simulated CiA 402 drive for homing tests.

Stands in for a real CiA 402 EtherCAT drive so homemod_cia402 can be exercised
without hardware. One instance = one drive/joint. It reproduces the two
behaviours that matter for the drive-internal homing path:

  1. Op-mode handshake: echoes opmode-cmd -> opmode-fb after mode-delay cycles
     (exercises homemod's WAIT_MODE / WAIT_CSP states).
  2. Drive-internal homing WITH the origin step: while commanded in HOMING mode
     (opmode 6) with home-cmd asserted, it drives pos-fb toward a simulated home
     switch (approach-pos) so the DRO visibly moves, then asserts homing-attained
     AND atomically redefines its position origin — pos-fb takes a STEP to
     home-fb. That step is what tripped a spurious following error before the
     get_at_index_search_wait() fix in homemod_cia402.c. In CSP mode (opmode 8)
     it is a plain position loopback (pos-fb follows pos-cmd): a perfect servo.

Wire pos-cmd/pos-fb to motmod's joint.N.motor-pos-cmd/fb and the opmode/home
pins to homemod.N.*.""";

pin in  float pos_cmd         "CSP target position (from motmod)";
pin out float pos_fb          "Actual position feedback";
pin in  u32   opmode_cmd      "Requested CiA 402 op mode (from homemod)";
pin out u32   opmode_fb       "Active op mode";
pin in  bit   home_cmd        "Drive home command (from homemod)";
pin out bit   homing_attained "Home found";
pin out bit   homing_error    "Drive homing fault (always 0 here)";

param rw float home_fb        = 0.0  "pos-fb after origin redefinition";
param rw float approach_pos   = 5.0  "simulated home-switch position";
param rw float approach_speed = 0.02 "pos-fb change per cycle while seeking";
param rw s32   mode_delay     = 5    "cycles to echo opmode-cmd -> opmode-fb";

variable int mode_timer = 0;
variable int attained = 0;

function _;
license "GPL";
;;

#define CIA402_OP_CSP     8
#define CIA402_OP_HOMING  6

/* 1. Operation-mode handshake with a small delay. */
if (opmode_fb != opmode_cmd) {
    int delay = mode_delay > 0 ? mode_delay : 1;
    if (++mode_timer >= delay) {
        opmode_fb = opmode_cmd;
        mode_timer = 0;
    }
} else {
    mode_timer = 0;
}

/* 2. Position behaviour by active mode. */
if (opmode_fb == CIA402_OP_HOMING) {
    if (home_cmd && !attained) {
        /* Seek the simulated home switch, moving pos-fb gradually so the DRO
           shows motion and the per-cycle delta stays well under MIN_FERROR. */
        double speed = approach_speed < 0.0 ? -approach_speed : approach_speed;
        double d = approach_pos - pos_fb;
        double ad = d < 0.0 ? -d : d;
        if (ad <= speed) {
            /* Reached the switch: atomically redefine the position origin.
               pos-fb STEPS to home-fb — the discontinuity that previously
               tripped a following error. */
            attained = 1;
            homing_attained = 1;
            pos_fb = home_fb;
        } else {
            pos_fb += (d > 0.0) ? speed : -speed;
        }
    } else if (attained) {
        /* Hold at the redefined origin while still in homing mode. */
        pos_fb = home_fb;
        homing_attained = 1;
    }
    /* else: home-cmd not yet asserted — drive idle in homing mode, hold. */
} else {
    /* CSP (or anything else): perfect position loopback. */
    pos_fb = pos_cmd;
    attained = 0;
    homing_attained = 0;
}
homing_error = 0;
