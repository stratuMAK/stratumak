
# Where motion tells X and Y to go, every servo cycle. filestream records in
# the servo thread and writes from its own I/O thread, so the capture starts
# with the first cycle and nothing is lost to a client falling behind (the
# halsampler WebSocket stream this replaced needed a subscribe-before-motion
# sleep, and failed the test whenever it lost a sample under load).

load filestream sample_cfg=ff outfile=result.halsamples tag depth=65536 samples=0

addf filestream.read      servo-thread

net Xpos => filestream.sample.0
net Ypos => filestream.sample.1
