component logburst "floods the stmak log ring on demand";

// The burst a machine makes at thread start -- more messages in one servo
// cycle than the ring holds -- as a pin.  Whether the burst is chatter the
// log prints (INFO) or lines nobody prints (DEBUG, which the ring's floor
// keeps out) is the test's choice: level is the severity, 0..3.
pin in bit fire;
pin in u32 count = 3000;
pin in u32 level = 1;
pin out u32 bursts;

variable int fire_last;

function _;
license "GPL";
;;

FUNCTION(_) {
  if (fire && !fire_last) {
    for (uint32_t i = 0; i < count; i++) {
      STMAK_LOG(level, "burst %u of %u", i, count);
    }
    bursts++;
  }
  fire_last = fire;
}
