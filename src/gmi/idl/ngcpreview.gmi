# NGC Preview API
# Server-side G-code interpretation for preview geometry generation.
# Each request creates a fresh interpreter instance (multi-instance safe).

@api ngcpreview
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 1
@prefix ngcpreview
@rest_export true

# ─── Enums ───

# Segment type classification
enum SegmentType {
    TRAVERSE = 1
    FEED = 2
    ARC = 3
    PROBE = 4
}

# ─── Types ───

# 9-axis position (machine coordinates after rotation/translation)
type Position {
    x: f64
    y: f64
    z: f64
    a: f64
    b: f64
    c: f64
    u: f64
    v: f64
    w: f64
}

# A single line segment in the preview
type Segment {
    type: SegmentType
    line_no: i32
    # Index into PreviewResult.files of the source file line_no belongs to.
    # An o-word call into a separate file restarts line numbering, so
    # (file_idx, line_no) — not line_no alone — identifies a program
    # location. 0 is the previewed file itself.
    file_idx: i32
    start: Position
    end: Position
    feedrate: f64
    tool_offset: Position
    # Arc-specific fields (only set for ARC segments)
    center_x: f64
    center_y: f64
    rotation: i32
    plane: i32
}

# A dwell (pause) point
type Dwell {
    line_no: i32
    file_idx: i32
    pos: Position
    seconds: f64
    plane: i32
}

# Tool change event in the preview stream
type ToolChange {
    line_no: i32
    file_idx: i32
    tool_no: i32
}

# Complete preview result for a G-code file
type PreviewResult {
    segments: []Segment
    dwells: []Dwell
    tool_changes: []ToolChange
    error: string
    # Highest line number reached in the previewed file itself. Lines
    # executed inside called sub-files are NOT counted: they belong to a
    # different file and their numbering is independent.
    max_line: i32
    # Source files referenced by file_idx. Index 0 is always the previewed
    # file; further entries are appended in the order o-word calls first
    # reach them. A client that ignores file_idx sees exactly the classic
    # (file-blind) behaviour.
    files: []string
    # Active G5x offset (index + 9-axis values) for coordinate display
    g5x_index: i32
    g5x_offset: Position
    # Active G92 offset for coordinate display
    g92_offset: Position
    # XY rotation angle (radians) for rotated coordinate systems
    xy_rotation: f64
    # Active plane (1=XY, 2=YZ, 3=XZ) for arc linearization
    plane: i32
}

# ─── Functions ───

# Generate preview geometry from a G-code file on the server.
# The file path must be accessible on the server filesystem.
@method "POST"
@path "/file"
func gen_preview(filename: string, initcodes: string, unitcode: string) -> PreviewResult

# Result of a file retrieval request.
type FileResult {
    lines: []string
    error: string
}

# Retrieve the contents of a G-code file from the server.
# The file must reside in an allowed directory (PROGRAM_PREFIX or SUBROUTINE_PATH).
@method "POST"
@path "/get_file"
func get_file(filename: string @notempty) -> FileResult

# Result of evaluating a numeric G-code expression.
type EvalResult {
    value: f64
    error: string
}

# Evaluate a numeric G-code expression (e.g. a touch-off value that may
# contain [brackets] and functions such as sin/atan). Runs on a fresh
# interpreter instance without opening a file; used by AXIS for live
# validation of values typed into Touch Off / MDI entry dialogs.
@method "POST"
@path "/eval"
func eval_expression(expr: string) -> EvalResult
