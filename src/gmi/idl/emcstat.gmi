# EMC Status API
# Read-only watchable machine status — replaces linuxcnc.stat() for UI clients.
# Gateway module (emcgateway) polls NML internally and exposes status via WebSocket.
#
# Constants defined here (TaskMode, TaskState, etc.) replace linuxcnc.MODE_*,
# linuxcnc.STATE_*, etc. Python clients get IntEnum classes.

@api emcstat
@author "Fred Proctor & Will Shackleford (emc_nml.hh)"
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 1
@prefix emcstat
@rest_export true

# ─── Constants ───

const MAX_JOINTS = 16
const MAX_AXIS = 9
const MAX_AIO = 64
const MAX_DIO = 64

# ─── Enums ───

# Task mode (linuxcnc.MODE_*)
enum TaskMode {
    MANUAL = 1
    AUTO = 2
    MDI = 3
}

# Task state (linuxcnc.STATE_*)
enum TaskState {
    ESTOP = 1
    ESTOP_RESET = 2
    OFF = 3
    ON = 4
}

# Interpreter state (linuxcnc.INTERP_*)
enum InterpState {
    IDLE = 1
    READING = 2
    PAUSED = 3
    WAITING = 4
}

# Execution state (linuxcnc.TASK_EXEC_*)
enum ExecState {
    ERROR = 1
    DONE = 2
    WAITING_FOR_MOTION = 3
    WAITING_FOR_MOTION_QUEUE = 4
    WAITING_FOR_IO = 5
    WAITING_FOR_MOTION_AND_IO = 7
    WAITING_FOR_DELAY = 8
    WAITING_FOR_MCODE_HANDLER = 9
    WAITING_FOR_SPINDLE_ORIENTED = 10
}

# Trajectory mode (linuxcnc.TRAJ_MODE_*)
enum TrajMode {
    FREE = 1
    COORD = 2
    TELEOP = 3
}

# Kinematics type (linuxcnc.KINEMATICS_*)
enum KinematicsType {
    IDENTITY = 1
    FORWARD_ONLY = 2
    INVERSE_ONLY = 3
    BOTH = 4
}

# ─── Types ───

type Position {
    x: f64
    y: f64
    z: f64
    a: f64
    b: f64
    c: f64
    u: f64
    v: f64
    w: f64
}

type JointInfo {
    homed: bool
    homing: bool
    enabled: bool
    fault: bool
    inpos: bool            # joint is in position (within ferror band, stopped)
    min_soft_limit: bool   # currently at/beyond the min soft limit
    max_soft_limit: bool   # currently at/beyond the max soft limit
    min_hard_limit: bool
    max_hard_limit: bool
    override_limits: bool
    joint_type: i32        # 1=LINEAR, 2=ANGULAR (Python attr jointType)
    units: f64             # joint units scale (machine units per mm/deg)
    backlash: f64          # configured backlash compensation
    min_position_limit: f64 # configured min soft-limit position
    max_position_limit: f64 # configured max soft-limit position
    min_ferror: f64        # min following-error limit
    max_ferror: f64        # max following-error limit
    ferror_current: f64    # current following error
    ferror_highmark: f64   # peak following error since reset
    velocity: f64
    input: f64             # actual position (joint_actual_position)
    output: f64            # commanded position (joint_position)
    limit: i32             # bitmask: 1=minHard, 2=maxHard, 4=minSoft, 8=maxSoft
}

type SpindleInfo {
    speed: f64
    direction: i32
    brake: bool
    enabled: bool
    override: f64
    override_enabled: bool
    homed: bool
    orient_state: i32
    orient_fault: i32
}

type AxisInfo {
    velocity: f64
    min_position_limit: f64
    max_position_limit: f64
}

type StatTaskInfo {
    mode: TaskMode
    state: TaskState
    interp_state: InterpState
    exec_state: ExecState
    # The G-code the interpreter is running. For a program that needed a
    # [FILTER] converter this is the controller's filtered output, NOT what
    # the operator opened — it is the file whose line numbers execution
    # reports, and the one get_file and the preview must read.
    file: string
    # What the operator opened, which a filtered program spells differently
    # (an image, a DXF, a script). Equal to `file` when no filter applied.
    # Display only: titles, recent-file lists, "generated from" — never an
    # input to anything that reads or interprets G-code.
    source_file: string
    # A [FILTER] conversion is running, with its percentage if the filter
    # reports one (FILTER_PROGRESS on stderr). The previously loaded program
    # stays open and executable until the new one is ready, so a filter that
    # fails leaves the controller as it was.
    filtering: bool
    filter_progress: i32
    command: string
    line: i32
    motion_line: i32
    current_line: i32
    read_line: i32
    # Source file the executing segment came from. An o-word call into a
    # separate file restarts line numbering at 0 (interp_o_word.cc
    # control_back_to), so motion_line/current_line are meaningless without
    # it. Empty while nothing tagged is executing; equals `file` at top
    # level. UIs must not highlight a line when this names a file they are
    # not displaying.
    motion_file: string
    queued_mdi_commands: i32
    optional_stop: bool
    block_delete: bool
    task_paused: bool
    g5x_index: i32
    program_units: i32      # 1=inch, 2=mm, 3=cm (canon length units)
    delay_left: f64         # seconds remaining in a G4 dwell
    call_level: i32         # interpreter subroutine nesting (0 = top level)
    input_timeout: i32      # M66 wait: 0=none/cleared, 1=timed out, 2=waiting
}

type StatMotionInfo {
    mode: TrajMode
    enabled: bool
    in_position: bool
    paused: bool
    feedrate: f64
    rapidrate: f64
    max_velocity: f64
    velocity: f64
    distance_to_go: f64
    dtg: Position
    current_vel: f64
    motion_id: i32
    motion_line: i32
    motion_type: i32        # feed type: 0=traverse, 1=feed, 2=arc, etc.
    feed_override_enabled: bool
    adaptive_feed_enabled: bool
    feed_hold_enabled: bool
    queue: i32              # TP motion queue depth
    queue_full: bool
}

type StatFull {
    task: StatTaskInfo
    motion: StatMotionInfo
    position: Position
    actual_position: Position
    joint_actual_position: [MAX_JOINTS]f64
    joint_position: [MAX_JOINTS]f64   # commanded joint positions
    probed_position: Position
    g5x_offset: Position
    g92_offset: Position
    tool_offset: Position
    rotation_xy: f64
    joints: []JointInfo
    spindle: []SpindleInfo
    axis: []AxisInfo
    active_gcodes: []i32
    active_mcodes: []i32
    active_settings: []f64
    kinematics_type: KinematicsType
    joints_count: i32
    num_extrajoints: i32
    axis_mask: i32
    flood: bool
    mist: bool
    lube_on: bool
    tool_in_spindle: i32
    pocket_prepped: i32     # tool table slot (idx) prepped for the next change,
                            # -1 when idle; index into tool_table, as in 2.9
    tool_from_pocket: i32
    linear_units: f64
    homed: [MAX_JOINTS]bool
    limit: [MAX_JOINTS]i32
    state: i32              # RCS state for connectivity check
    rcs_status: i32         # RCS command status (1=DONE, 2=EXEC, 3=ERROR)
    debug: i32              # debug flags bitmask
    jog_axis: i32           # selected jog axis (0=X .. 8=W, -1=none)
    jog_increment: f64      # current jog increment (0 = continuous)
    jog_speed: f64          # linear jog speed (units/sec)
    ajog_speed: f64         # angular jog speed (deg/sec)
    preview_seq: i32        # increments on any change that invalidates preview
    boot_id: i64            # task start timestamp (unix ns) — an opaque identity
                            # token for THIS run of the task. A client that sees
                            # it change is talking to a restarted task and must
                            # re-adopt the server's state rather than trust any
                            # cached view: preview_seq and every other counter
                            # restart with the task and can collide with the
                            # value the client last saw.
    heartbeat: i32          # monotonic liveness counter (increments each status build)
    angular_units: f64      # angular units scale (machine deg per user angular unit)
    cycle_time: f64         # trajectory planner cycle time (seconds)
    acceleration: f64       # current commanded acceleration
    max_acceleration: f64   # configured max acceleration (traj)
    active_queue: i32       # number of motions currently executing in the TP
    estop: i32              # 1 when in estop, else 0
    interpreter_errcode: i32 # last interpreter error code (0 = none)
    lube_level: i32         # lube level sensor (0/1)
    probe_tripped: bool     # probe input tripped since last clear
    probe_val: i32          # current probe input value
    probing: bool           # a probe move is in progress
    ain: [MAX_AIO]f64       # motion analog inputs
    aout: [MAX_AIO]f64      # motion analog outputs
    din: [MAX_DIO]i32       # motion digital inputs
    dout: [MAX_DIO]i32      # motion digital outputs
}

# ─── Machine description ───
#
# TaskInfo answers "what is this machine made of, and what is wired"; StatFull
# above answers "what is it doing right now". Nothing that changes while the
# machine runs belongs here, and nothing already in StatFull (axis_mask,
# spindle count, units) is repeated here.

# REST instance names of the modules a UI client talks to directly, so a client
# never has to derive them from a naming convention. Only modules the CLIENT
# addresses over REST/WS appear here: the motion, io, persist and halui
# instances are milltask's business alone and stay out of it.
#
# An empty string means "not configured" — the feature is absent and the client
# must not probe for it. A name that IS configured is guaranteed to exist:
# milltask resolves every one of them at startup and refuses to start otherwise.
type TaskPeers {
    tooltable: string           # raw slot store backing stat.tool_table
    preview: string             # ngcpreview instance for this task
    manualtoolchange: string    # manualtoolchange instance, if one is loaded
    pyvcp: string               # pyvcp panel instance, if one is loaded
}

# What the operator UI should offer, decided by what is actually wired in HAL —
# not by INI declarations. A config can declare SPINDLES = 1 and wire nothing;
# 2.9 asked HAL (does anything drive spindle.0.forward?) and so do we. The
# difference is that the pin names are qualified here — spindle and joint pins
# with this task's motion instance, coolant pins with its io instance — where
# those names are known, instead of guessed by the client.
# Each flag is one wiring fact — "this pin is driven" — deliberately NOT a
# ready-made "show the spindle controls" verdict. Which widget a fact enables is
# the client's policy and differs between them: AXIS shows its clockwise button
# for forward/on/speed but its counter-clockwise button for reverse/speed, so a
# lathe wiring only one direction gets one button. A single collapsed flag would
# quietly give it both.
type TaskCaps {
    spindle_forward: bool       # spindle 0 forward pin is driven
    spindle_reverse: bool       # spindle 0 reverse pin is driven
    spindle_on: bool            # spindle 0 on pin is driven
    spindle_speed: bool         # any spindle 0 speed-out pin is driven
    spindle_brake: bool         # spindle 0 brake pin is driven
    limit_switch_override: bool # any joint has a limit switch input driven
    coolant_mist: bool          # io coolant-mist pin is driven
    coolant_flood: bool         # io coolant-flood pin is driven
}

type TaskInfo {
    peers: TaskPeers
    caps: TaskCaps
}

# ─── Functions ───

# Full machine status, pushed via WebSocket at 50ms intervals.
#
# @watch_delta: after the first push a frame carries ONLY the top-level keys
# that changed, so a subscriber must merge onto the previous object rather than
# replace it. milltask has always registered the watch this way
# (internal/task/watches.go) — a full ~10 KB StatFull at 20 Hz per client is
# what the diff exists to avoid — but until now the IDL did not say so, and a
# generated client written against "every frame is a whole StatFull" broke on
# the second frame. The REST GET on this same path is unaffected: it always
# returns the complete object.
@watch true
@watch_delta true
@watch_default_rate 50ms
@method "GET"
@path "/stat"
func get_stat() -> StatFull

# Machine description: peer instance names + wired-capability flags.
# Read once at client startup; not watchable, and deliberately not part of the
# 50ms stat push.
@method "GET"
@path "/info"
func get_info() -> TaskInfo
