# Tool Table API
# CRUD operations on the tool table via shared memory

@api tools
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 1
@prefix tools
@rest_export true

# ─── Types ───

type ToolEntry {
    toolno: i32
    pocketno: i32 @min(0) @max(1000)
    x_offset: f64
    y_offset: f64
    z_offset: f64
    a_offset: f64
    b_offset: f64
    c_offset: f64
    u_offset: f64
    v_offset: f64
    w_offset: f64
    diameter: f64
    frontangle: f64
    backangle: f64
    orientation: i32 @min(0) @max(9)
    comment: string @maxlen(255)
    updated: i64          # opaque modification stamp set by the server on
                          # every read. Echo it back unchanged in put_tool to
                          # get optimistic concurrency: the write is refused
                          # (409) when the tool changed since it was read.
                          # 0 skips the check (last-write-wins).
}

type PutToolResult {
    ok: bool
    index: i32
}

# Machine linear-unit metadata for display. The tool table is stored in mm
# (the mm-everywhere convention), but an operator on an inch machine must see
# and type inches — otherwise every length reads 25.4x wrong (the GP-16 class).
type ToolUnits {
    linearScale: f64      # machine linear units per mm: 1.0 on a mm machine,
                          # 1/25.4 (~0.03937) on an inch machine. DISPLAY =
                          # stored_mm * linearScale; STORE = typed / linearScale.
                          # Only X/Y/Z/U/V/W offsets and diameter scale; A/B/C
                          # and front/back angles are degrees, counts are counts.
    metric: bool          # true if the machine's native linear unit is mm
}

# ─── Functions ───

# List all tools in the tool table
@method "GET"
@path "/"
func list_tools() -> []ToolEntry

# Get a single tool by tool number
@method "GET"
@path "/{toolno}"
func get_tool(toolno: i32) -> ToolEntry

# Create or update a tool
@method "PUT"
@path "/{toolno}"
func put_tool(toolno: i32 @min(1), entry: ToolEntry) -> PutToolResult

# Delete a tool by tool number
@method "DELETE"
@path "/{toolno}"
func delete_tool(toolno: i32) -> CmdResult

# Reload tool table from file
@method "POST"
@path "/reload"
func reload_tools() -> CmdResult

# Report the machine's linear-unit scale so a UI can display/enter tool
# lengths in the operator's units. Literal path — matched ahead of /{toolno}.
@method "GET"
@path "/units"
func get_units() -> ToolUnits

# ─── Shared Types ───

type CmdResult {
    ok: string
}
