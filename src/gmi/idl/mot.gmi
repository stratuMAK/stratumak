@doc "Get current velocity"
@rt_safe "true"
func status_get_current_vel() -> f64

@doc "Get spindleSync flag"
@rt_safe "true"
func status_get_spindle_sync() -> i32

@doc "Get spindle revs for a given spindle"
@rt_safe "true"
func status_get_spindle_revs(spindle: i32) -> f64

@doc "Get spindle direction for a given spindle"
@rt_safe "true"
func status_get_spindle_direction(spindle: i32) -> i32

@doc "Get spindle at-speed flag for a given spindle"
@rt_safe "true"
func status_get_spindle_at_speed(spindle: i32) -> i32

@doc "Get spindle speed-in for a given spindle"
@rt_safe "true"
func status_get_spindle_speed_in(spindle: i32) -> f64

@doc "Get spindle index-enable for a given spindle"
@rt_safe "true"
func status_get_spindle_index_enable(spindle: i32) -> i32

@doc "Get enables_new value"
@rt_safe "true"
func status_get_enables_new() -> u8

@doc "Get commanded spindle speed for a given spindle"
@rt_safe "true"
func status_get_spindle_speed(spindle: i32) -> f64

# The RT-side Cartesian feedback position. control.c runs the forward
# kinematics on joint->pos_fb into status->carte_pos_fb every servo cycle, so a
# cyclic function that needs a machine point reads it here instead of
# recomputing it — and instead of reaching for motstat, which is the non-RT
# snapshot interface (its h_get_pos_fb takes the reader mutex and copies the
# whole emcmot_status_t; @rt_safe on it would be a false claim that
# -Wfunction-effects would reject).
#
# The return value is carte_pos_fb_ok: 0 when the feedback means something,
# -EINVAL when it does not (joints not all homed on a non-identity kinematics).
# A caller that gates an interlock on the position MUST honour it and fail
# towards "the machine might be in there" — pos is left untouched in that case.
@doc "Get actual Cartesian position (RT-side, no snapshot)"
@rt_safe "true"
func status_get_carte_pos_fb(pos: Pose out) -> i32

# The motion state a Go module's cyclic function hands its control loop, so the
# loop sees motion and its own pins from the same servo cycle
# (docs/dev/PNPTASK_RT_BOUNDARY.md §4.5). Read from the RT status struct like
# status_get_carte_pos_fb -- reader and producer are the same thread -- and
# after motion-controller it is this cycle's state. Always returns 0; the
# positions carry their own _ok flags.
@doc "Get the motion state snapshot (RT-side)"
@rt_safe "true"
func status_get_snapshot(snap: Snapshot out) -> i32

# ─── Trajectory intake from the servo thread ───
#
# The planner intake of motctl's set_term_cond, set_line and set_circle, for a
# cyclic function in another module that hands motmod segments one per servo
# cycle (pnptask's leg feed, docs/dev/PNPTASK_RT_BOUNDARY.md §13). Each runs
# the code the command handler runs for the motctl command of the same name --
# the mode and enable check, the range and limit checks, the planner's add,
# the abort and error flag on a refusal -- and returns the EMCMOT_COMMAND_*
# status the handler would have stored in commandStatus.
#
# To be called ONLY from a function in motmod's own servo thread, as
# status_get_snapshot: they take no lock, and they leave the command slot and
# its echo (commandNumEcho, commandStatus) alone, which stay motctl's.

@doc "Set the termination condition for the segments that follow (servo thread)"
@rt_safe "true"
func traj_set_term_cond(cond: i32, tolerance: f64) -> i32

@doc "Append a linear segment to the planner (servo thread)"
@rt_safe "true"
func traj_add_line(seg: LineSeg) -> i32

@doc "Append a circular segment to the planner (servo thread)"
@rt_safe "true"
func traj_add_circle(seg: CircleSeg) -> i32

