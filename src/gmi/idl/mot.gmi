# Motion Controller Reverse-Callback API
#
# Provided by motmod, consumed by tpmod and homemod.
# Looked up via get_api() at Start() time.

@api mot
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 4
@prefix mot
@rest_export false

# ─── Types ───

type Pose {
    x: f64
    y: f64
    z: f64
    a: f64
    b: f64
    c: f64
    u: f64
    v: f64
    w: f64
}

# What a cyclic function in a Go module needs of the motion state, read in one
# call from the RT status struct (status_get_snapshot). The fields mean what
# motstat's MotionStatus fields of the same name mean; the per-joint flags are
# bit masks, bit n for joint n.
type Snapshot {
    command_num_echo: i32
    command_status: i32
    motion_state: i32
    enabled: i32
    inpos: i32
    queue_depth: i32
    id: i32
    distance_to_go: f64
    current_vel: f64
    carte_pos_cmd: Pose
    carte_pos_fb: Pose
    carte_pos_cmd_ok: i32
    carte_pos_fb_ok: i32
    num_joints: i32
    joints_homed: u32
    joints_homing: u32
}

type Cartesian {
    x: f64
    y: f64
    z: f64
}

# A segment handed to the planner by a cyclic function in motmod's own servo
# thread (traj_add_line / traj_add_circle): what motctl's set_line and
# set_circle carry, field for field. turn is the circle's turn count; a line
# carries the indexer joint there, as motctl's set_line does.
type LineSeg {
    pos: Pose
    id: i32
    motion_type: i32
    turn: i32
    vel: f64
    ini_maxvel: f64
    acc: f64
    feed_mm_per_min: f64
}

type CircleSeg {
    pos: Pose
    center: Cartesian
    normal: Cartesian
    id: i32
    motion_type: i32
    turn: i32
    vel: f64
    ini_maxvel: f64
    acc: f64
    feed_mm_per_min: f64
}

# ─── I/O callbacks ───

@doc "Write a digital output"
@rt_safe "true"
func dio_write(index: i32, value: i8)

@doc "Write an analog output"
@rt_safe "true"
func aio_write(index: i32, value: f64)

# ─── Rotary unlock callbacks ───

@doc "Set rotary unlock state for a joint"
@rt_safe "true"
func set_rotary_unlock(jnum: i32, unlock: i32)

@doc "Get rotary unlock state for a joint"
@rt_safe "true"
func get_rotary_unlock(jnum: i32) -> i32

# ─── Axis limit queries ───

@doc "Get velocity limit for an axis"
@rt_safe "true"
func axis_get_vel_limit(axis: i32) -> f64

@doc "Get acceleration limit for an axis"
@rt_safe "true"
func axis_get_acc_limit(axis: i32) -> f64

