@api tooltable
@author "Dewey Garrett (tooldata.hh)"
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 3
@prefix tooltable
@rest_export true

# The tool table is an ARRAY INDEXED BY idx, exactly as 2.9's tooldata is
# (emc/tooldata/tooldata_mmap.cc).  This is the raw store: it is addressed by
# storage slot, not by tool number.  The operator-facing API is the milltask
# `tools` API, which is tool-number addressed and resolves to an idx here.
#
#   idx 0        the SPINDLE slot.  Always present.  It holds a copy of the
#                tool currently in the spindle (or toolno -1/0 when empty).
#                It is a slot, not a tool: it is never a second row for a tool
#                that also lives in the table, and it is never listed as an
#                editable tool by a UI.
#   idx 1..N     the tool table proper.
#
# On a RANDOM toolchanger idx IS the carousel pocket, so idx == pocketno for
# every row and a tool change swaps rows 0 and idx.  On a NON-RANDOM changer
# idx is a synthetic slot number ("fakepocket", assigned 1..n in load order)
# and `pocketno` is the unrelated carousel pocket the operator sees; a tool
# change copies row idx to row 0 verbatim.
#
# Keying by idx rather than by toolno is what makes the spindle slot
# representable at all: keyed by toolno the spindle row collided with a real
# T0 entry and the stored toolno had to be clobbered with the key, which sent
# Interp::set_tool_parameters into its empty-spindle branch (#5400 stuck at 0
# after M6) and published a phantom tool 0 to every UI.

type ToolEntry {
    idx: i32 @min(0) @max(1000)
                          # storage slot; 0 = spindle.  Filled from the key on
                          # every read; ignored in a put (the path carries it).
    toolno: i32 @min(-1)  # -1 = slot empty/unknown (2.9 tooldata_entry_init)
    pocketno: i32 @min(-1) @max(1000)
    x_offset: f64
    y_offset: f64
    z_offset: f64
    a_offset: f64
    b_offset: f64
    c_offset: f64
    u_offset: f64
    v_offset: f64
    w_offset: f64
    diameter: f64
    frontangle: f64
    backangle: f64
    orientation: i32 @min(0) @max(9)
    comment: string @maxlen(255)
    updated: i64          # opaque modification stamp, filled from the persist
                          # row on every read. put_tool with a non-zero value
                          # refuses the write when the stored stamp differs
                          # (optimistic concurrency); 0 skips the check, which
                          # is what the canon/G10/iocontrol writers send.
}

type PutToolResult {
    ok: bool
    index: i32
}

type DeleteResult {
    ok: bool
}

# A resolved storage slot. -1 means "no such slot" — an absent tool or a full
# table — and is a normal answer, not an error.
type IndexResult {
    idx: i32 @min(-1) @max(1000)
}

# Store-wide properties of THIS table, for consumers that would otherwise
# re-derive them from the INI and be free to disagree with the store.
type StoreInfo {
    random_toolchanger: bool
                          # what an idx means here: the carousel pocket (true)
                          # or a synthetic slot (false).  See the idx notes
                          # above — the two readings of the same number are
                          # what a caller must not get wrong.
}

@method GET
@path /
@rc_error
func list_tools(tools: []ToolEntry out) -> i32

# The store is the single source of truth for what an idx means: it is told
# once, on its load line (random_toolchanger=), and every consumer asks it
# rather than reading [EMCIO]RANDOM_TOOLCHANGER for itself.  Three modules
# reading the same INI key is three chances to disagree — and on a
# multi-instance server they DID, because the store resolved the global
# section while its task resolved the task's namespaced one.
#
# Literal first segment — no conflict with the /{idx} routes below.
@method GET
@path /info
@rc_error
func get_info(info: StoreInfo out) -> i32

# Resolve a tool number to its storage slot, mirroring 2.9's
# tooldata_find_index_for_tool: -1 for toolno -1 or a tool not in the table;
# 0 for toolno 0 on a non-random changer (the empty spindle IS slot 0); and
# otherwise the lowest non-zero slot holding that tool number.  The spindle
# slot never wins over a real table slot, so a loaded tool resolves to its
# home slot and not to the spindle copy of itself.
#
# Literal first segment — no conflict with the /{idx} routes below.
@method GET
@path /find/{toolno}
@rc_error
func find_index_for_tool(toolno: i32 @min(-1), result: IndexResult out) -> i32

# The lowest unused slot >= 1, or -1 when the table is full.  Used when a UI
# creates a tool on a non-random changer, where the slot is an implementation
# detail the operator never sees.
@method GET
@path /nextfree
@rc_error
func next_free_index(result: IndexResult out) -> i32

@method GET
@path /{idx}
@rc_error
func get_tool(idx: i32 @min(0) @max(1000), entry: ToolEntry out) -> i32

@method PUT
@path /{idx}
@rc_error
func put_tool(idx: i32 @min(0) @max(1000), entry: ToolEntry, result: PutToolResult out) -> i32

# Slot 0 cannot be deleted: the spindle slot is a structural invariant of the
# table, and its absence is what made an empty tool table crash every UI that
# reads tool_table[0].
@method DELETE
@path /{idx}
@rc_error
func delete_tool(idx: i32 @min(1) @max(1000), result: DeleteResult out) -> i32
