@api tooltable
@author "Dewey Garrett (tooldata.hh)"
@author "Sascha Ittner <sascha.ittner@modusoft.de>"
@license "GPL Version 2"
@version 1
@prefix tooltable
@rest_export true

type ToolEntry {
    toolno: i32
    pocketno: i32 @min(0) @max(1000)
    x_offset: f64
    y_offset: f64
    z_offset: f64
    a_offset: f64
    b_offset: f64
    c_offset: f64
    u_offset: f64
    v_offset: f64
    w_offset: f64
    diameter: f64
    frontangle: f64
    backangle: f64
    orientation: i32 @min(0) @max(9)
    comment: string @maxlen(255)
    updated: i64          # opaque modification stamp, filled from the persist
                          # row on every read. put_tool with a non-zero value
                          # refuses the write when the stored stamp differs
                          # (optimistic concurrency); 0 skips the check, which
                          # is what the canon/G10/iocontrol writers send.
}

type PutToolResult {
    ok: bool
    index: i32
}

type DeleteResult {
    ok: bool
}

@method GET
@path /
@rc_error
func list_tools(tools: []ToolEntry out) -> i32

@method GET
@path /{toolno}
@rc_error
func get_tool(toolno: i32, entry: ToolEntry out) -> i32

@method PUT
@path /{toolno}
@rc_error
func put_tool(toolno: i32, entry: ToolEntry, result: PutToolResult out) -> i32

@method DELETE
@path /{toolno}
@rc_error
func delete_tool(toolno: i32, result: DeleteResult out) -> i32
