#: src/cnc/rs274ngc/interp_arc.cc:111 src/cnc/rs274ngc/interp_arc.cc:287
#, c-format
msgid ""
"Zero-radius arc: start=(%c%.4f,%c%.4f) center=(%c%.4f,%c%.4f) end=(%c%.4f,"
"%c%.4f) r1=%.4f r2=%.4f"
msgstr ""
"Cung tròn có bán kính băng không: điểm đầu=(%c%.4f,%c%.4f) tâm=(%c%.4f,"
"%c%.4f) cuối=(%c%.4f,%c%.4f) r1=%.4f r2=%.4f"

#: src/cnc/rs274ngc/interp_arc.cc:122 src/cnc/rs274ngc/interp_arc.cc:296
#, c-format
msgid ""
"Radius to end of arc differs from radius to start: start=(%c%.4f,%c%.4f) "
"center=(%c%.4f,%c%.4f) end=(%c%.4f,%c%.4f) r1=%.4f r2=%.4f abs_err=%.4g "
"rel_err=%.4f%%"
msgstr ""
"Bán kính đến cuối của cung tròn khác với bán kính đến đầu: đầu=(%c%.4f,"
"%c%.4f) tâm=(%c%.4f,%c%.4f) cuối=(%c%.4f,%c%.4f) r1=%.4f r2=%.4f "
"abs_err=%.4g rel_err=%.4f%%"

#: src/cnc/rs274ngc/interp_check.cc:89
msgid "G4 not allowed with G2 or G3 because they both use P"
msgstr "G4 không cho phép với G2 hay G3 bởi vì chúng cùng sử dụng P"

#: src/cnc/rs274ngc/interp_check.cc:92
msgid "Line with G10 does not have L0, L1, L10, L11, L2, or L20"
msgstr "Dòng có G10 không được có L0, L1, L10, L11, L2, hay L20"

#: src/cnc/rs274ngc/interp_check.cc:93
msgid "P value not an integer with G10"
msgstr "Giá trị P không nguyên với G10"

#: src/cnc/rs274ngc/interp_check.cc:94
#, c-format
msgid "P value out of range (0-9) with G10 L%d"
msgstr "Giá trị P nằm ngoài phạm vi (0-9) với G10 L%d"

#: src/cnc/rs274ngc/interp_check.cc:95
#, c-format
msgid "P value out of range with G10 L%d"
msgstr "Giá trị P nằm ngoài phạm vi với G10 L%d"

#: src/cnc/rs274ngc/interp_check.cc:99
msgid "Between G5.2 and G5.3 codes, only additional G5.2 codes are allowed."
msgstr "Giữa các mã G5.2 và G5.3, chỉ mã G5.2 là được phép thêm vào."

#: src/cnc/rs274ngc/interp_check.cc:265
msgid ""
"D word with no G41, G41.1, G42, G42.1, G71, G71.1, G71.2 or G96 to use it"
msgstr ""
"Từ D mà không có G41, G41.1, G42, G42.1, G71, G71.1, G71.2 hay G96 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:276
#, fuzzy
msgid ""
"$ (spindle selection) word with no M3, M4, M5, M19, M51, G33, G33.1, G76, "
"G95, G96 or G97 to use it"
msgstr ""
"Từ $ (spindle selection) mà không có G41, G41.1, G42, G42.1, G76 G95 hay G96 "
"để dùng"

#: src/cnc/rs274ngc/interp_check.cc:283
#, fuzzy
msgid "E word with no G70, G76, M66, M67 or M68 to use it"
msgstr "Từ E mà không có G76, M3, M4, M5, M19, M51, M66, M67 hay M68 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:288
msgid "H word with no G43 or G76 to use it"
msgstr "Từ H mà không có G43 hay G76 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:296
msgid "I word with no G2, G3, G5, G5.1, G10, G33.1, G76, or G87 to use it"
msgstr "Từ I mà không có G2, G3, G5, G5.1, G10, G33.1, G76, hay G87 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:302
msgid "J word with no G2, G3, G5, G5.1, G10, G76 or G87 to use it"
msgstr "Từ J mà không có G2, G3, G5, G5.1, G10, G76 hay G87 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:308
msgid "K word with no G2, G3, G33, G33.1, G76, or G87 to use it"
msgstr "Từ K mà không có G2, G3, G33, G33.1, G76, hay G87 để dùng"

#: src/cnc/rs274ngc/interp_check.cc:320
msgid ""
"L word with no G10, cutter compensation, canned cycle, digital/analog input, "
"M98 or NURBS code"
msgstr ""
"Từ L không có G10, bù cắt, chu kỳ hủy, đầu vào số/tương tự, M98 hay mã NURBS"

#: src/cnc/rs274ngc/interp_check.cc:336
msgid ""
"P word with no G2 G3 G4 G10 G64 G5 G5.2 G76 G82 G86 G88 G89 or M50 M51 M52 "
"M53 M62 M63 M64 M65 M66 M98 or user M code to use it"
msgstr ""
"Từ P mà không có G2 G3 G4 G10 G64 G5 G5.2 G76 G82 G86 G88 G89 hay M50 M51 "
"M52 M53 M62 M63 M64 M65 M66 M98 hay mã M người dùng để sử dụng nó"

#: src/cnc/rs274ngc/interp_check.cc:342
msgid "P value not an integer with M19 G2 or G3"
msgstr "Giá trị P không nguyên với M19 G2 hay G3"

#: src/cnc/rs274ngc/interp_check.cc:344
msgid "P value must be 0,1,or 2 with M19"
msgstr "Giá trị P phải là 0,1, hay 2 với M19"

#: src/cnc/rs274ngc/interp_check.cc:346
msgid "P value should be 1 or greater with G2 or G3"
msgstr "Giá trị P phải là 1 hay lớn hơn với G2 hay G3"

#: src/cnc/rs274ngc/interp_check.cc:357
msgid ""
"Q word with no G5, G10, G64, G73, G76, G83, M19, M66, M67, M68 or user M "
"code that uses it"
msgstr ""
"Từ Q mà không có G5, G10, G64, G73, G76, G83, M19, M66, M67, M68 hay mã M "
"người dùng để sử dụng nó"

#: src/cnc/rs274ngc/interp_check.cc:370
msgid "R value must be within 0..360 with M19"
msgstr "Giá trị R phải nằm trong 0..360 với M19"

#: src/cnc/rs274ngc/interp_convert.cc:147
msgid "You must specify both X and Y coordinates for Control Points"
msgstr "Bạn phải chỉ ra cả hai tọa độ X và Y cho các điểm điều khiển"

#: src/cnc/rs274ngc/interp_convert.cc:150
msgid "Can specify P without X and Y only for the first control point"
msgstr "Chỉ có thể chỉ định P mà không có X và Y cho điểm điều khiển đầu tiên"

#: src/cnc/rs274ngc/interp_convert.cc:153
msgid "Must specify positive weight P for every Control Point"
msgstr "Phải chỉ định độ nặng P dương cho mỗi Điểm điều khiển"

#: src/cnc/rs274ngc/interp_convert.cc:156
msgid "Cannot make a NURBS with 0 feedrate"
msgstr "Không thể thực hiện một NURBS với tốc độ ăn dao bằng không"

#: src/cnc/rs274ngc/interp_convert.cc:186
msgid "Cannot use G5.3 without G5.2 first"
msgstr "Không thể sử dụng G5.3 mà không có G5.2 trước"

#: src/cnc/rs274ngc/interp_convert.cc:187
#, c-format
msgid ""
"You must specify a number of control points at least equal to the order L = "
"%d"
msgstr "Bạn phải chỉ định một số điểm điểu khiển ít nhất bằng thứ tự L = %d"

#: src/cnc/rs274ngc/interp_convert.cc:214
msgid "Cannot convert spline with cutter radius compensation"
msgstr "Không thể chuyển đổi trục chính với bù bán kính dao cắt"

#: src/cnc/rs274ngc/interp_convert.cc:224
msgid "Splines must be in the XY plane"
msgstr "Trục chính phải trong mặt phẳng XY"

#: src/cnc/rs274ngc/interp_convert.cc:229
msgid "Splines may not have motion in Z, A, B, or C"
msgstr "Trục chính không nên chuyển động trong Z, A, B, hay C"

#: src/cnc/rs274ngc/interp_convert.cc:233
msgid "Must specify both I and J with G5.1"
msgstr "Phải chỉ định cả hai I và J với G5.1"

#: src/cnc/rs274ngc/interp_convert.cc:255
msgid "Must specify both I and J, or neither"
msgstr "Phải chỉ định cả hai I và J hoặc không gì"

#: src/cnc/rs274ngc/interp_convert.cc:266
msgid "Must specify both P and Q with G5"
msgstr "Bạn phải chỉ ra cả hai P và Q với G5"

#: src/cnc/rs274ngc/interp_convert.cc:371
msgid ""
"The move just after exiting cutter compensation mode must be straight, not "
"an arc"
msgstr ""
"Việc di chuyển ngay sau khi thoát khỏi chế độ bù dao cắt phải thẳng, không "
"phải là cung tròn"

#: src/cnc/rs274ngc/interp_convert.cc:379
msgid "Cannot do an arc in planes G17.1, G18.1, or G19.1"
msgstr "Không thể thực hiện cung tròn trong mặt phẳng G17.1, G18.1, hay G19.1"

#: src/cnc/rs274ngc/interp_convert.cc:391
#: src/cnc/rs274ngc/interp_convert.cc:4781
msgid "Cannot feed with zero spindle speed in feed per rev mode"
msgstr ""
"Không thể cấp dao với tốc độ trục chính bằng không trong chế độ cấp dao theo "
"vòng"

