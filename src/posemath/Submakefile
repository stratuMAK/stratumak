INCLUDES += posemath
POSEMATHSRCS := $(addprefix posemath/, _posemath.c posemath.cc gomath.c sincos.c)
$(call TOOBJSDEPS, $(POSEMATHSRCS)) : EXTRAFLAGS=-fPIC
USERSRCS += $(POSEMATHSRCS) 
TARGETS += ../lib/libposemath.so ../lib/libposemath.so.0

../lib/libposemath.so.0: $(call TOOBJS,$(POSEMATHSRCS))
	$(ECHO) Creating shared library $(notdir $@)
	@mkdir -p ../lib
	@rm -f $@
	@$(CXX) $(LDFLAGS) -Wl,-soname,$(notdir $@) -shared -o $@ $^

$(patsubst ./posemath/%,../include/%,$(wildcard ./posemath/*.h)): ../include/%.h: ./posemath/%.h
	cp $^ $@
$(patsubst ./posemath/%,../include/%,$(wildcard ./posemath/*.hh)): ../include/%.hh: ./posemath/%.hh
	cp $^ $@
