ifdef HAVE_LIBMODBUS3

# Local configuration
MB2HAL_SRCS = \
        hal/user_comps/mb2hal/mb2hal.c \
	hal/user_comps/mb2hal/mb2hal_init.c \
	hal/user_comps/mb2hal/mb2hal_modbus.c \
	hal/user_comps/mb2hal/mb2hal_hal.c

MB2HAL_CCFLAGS = -fPIC -DDEBUG -Wall -I. $(GLIB_CFLAGS) $(LIBMODBUS_CFLAGS)
MB2HAL_LDFLAGS = -lpthread $(GLIB_LIBS) $(LIBMODBUS_LIBS)

$(call TOOBJSDEPS, $(MB2HAL_SRCS)) : EXTRAFLAGS += $(MB2HAL_CCFLAGS)
$(call TOOBJS, $(MB2HAL_SRCS)): Makefile.inc

USERSRCS += $(MB2HAL_SRCS)

# libiniparse is linked -l-style, not by feeding the versioned .so.0 path to
# the driver: clang's classification of the unknown ".0" suffix varies across
# builds, and one that treats it as a compilable input dies with "cannot
# specify -o when generating multiple output files". DT_NEEDED is the SONAME
# either way, so runtime resolution is unchanged.
../cmod/mb2hal.so: $(call TOOBJS, $(MB2HAL_SRCS)) ../lib/libiniparse.so.0
	$(ECHO) Linking $(notdir $@)
	@mkdir -p ../cmod
	$(Q)$(CC) -shared -o $@ $(filter %.o,$^) -L../lib -l:libiniparse.so.0 $(CMOD_LDFLAGS) $(MB2HAL_LDFLAGS)

TARGETS += ../cmod/mb2hal.so

endif # HAVE_LIBMODBUS3
