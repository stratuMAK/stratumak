component limit1 "Limit the output signal to fall between min and max";
pin in float in;
pin out float out;
pin in float min_=-1e20;
pin in float max_=1e20;
function _;
// Keeps running after the launcher has stopped the modules (modcompile,
// "option run_after_stop"): a ramp or filter can be carrying a stop to a drive.
option run_after_stop yes;
license "GPL";
author "Jeff Epler";
;;
FUNCTION(_) {
    double tmp = in;
    if(tmp < min_) tmp = min_;
    if(tmp > max_) tmp = max_;
    out = tmp;
}
