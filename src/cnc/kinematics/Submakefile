INCLUDES += cnc/kinematics

DELTAMODULESRCS := cnc/kinematics/lineardeltakins.cc
PYSRCS += $(DELTAMODULESRCS)
$(call TOOBJS, $(DELTAMODULESRCS)): EXTRAFLAGS += $(SILENCE_BOOST_INTERNAL_DIAGNOSTICS_FLAGS)

DELTAMODULE := ../lib/python/lineardeltakins.so
$(DELTAMODULE): $(call TOOBJS, $(DELTAMODULESRCS))
	$(ECHO) Linking python module $(notdir $@)
	$(CXX) $(LDFLAGS) -shared -o $@ $^ $(BOOST_PYTHON_LIB)
PYTARGETS += $(DELTAMODULE)

RDELTAMODULESRCS := cnc/kinematics/rotarydeltakins.cc
PYSRCS += $(RDELTAMODULESRCS)
$(call TOOBJS, $(RDELTAMODULESRCS)): EXTRAFLAGS += $(SILENCE_BOOST_INTERNAL_DIAGNOSTICS_FLAGS)

RDELTAMODULE := ../lib/python/rotarydeltakins.so
$(RDELTAMODULE): $(call TOOBJS, $(RDELTAMODULESRCS))
	$(ECHO) Linking python module $(notdir $@)
	$(CXX) $(LDFLAGS) -shared -o $@ $^ $(BOOST_PYTHON_LIB)
PYTARGETS += $(RDELTAMODULE)

$(patsubst ./cnc/kinematics/%,../include/%,$(wildcard ./cnc/kinematics/*.h)): ../include/%.h: ./cnc/kinematics/%.h
	cp $^ $@
$(patsubst ./cnc/kinematics/%,../include/%,$(wildcard ./cnc/kinematics/*.hh)): ../include/%.hh: ./cnc/kinematics/%.hh
	cp $^ $@

# ---------------------------------------------------------------------------
# GMI kinematics cmod modules
# ---------------------------------------------------------------------------


GMI_KINS_INCLUDE := stmak/pkg/cmodule
GMI_KINS_API_INCLUDE := stmak/generated/gmi/kins
GMI_KINS_COMMON := cnc/kinematics

GMI_KINS_CFLAGS = -fPIC -g -Os -Wall -Wextra -shared \
    -I $(GMI_KINS_INCLUDE) \
    -I $(GMI_KINS_API_INCLUDE) \
    -I $(GMI_KINS_COMMON)

GMI_KINS_DEPS = stmak/generated/gmi/kins/kins_api.h \
                $(wildcard stmak/pkg/cmodule/stmak_env.h)

# Helper: build a simple kins cmod .so from a single .c file
# $(1) = module name  $(2) = source dir relative to src/
define GMI_KINS_BUILD
../cmod/$(1).so: $(2)/$(1).c $$(GMI_KINS_DEPS)
	$$(ECHO) "Compiling GMI cmod $$(notdir $$@)"
	@mkdir -p $$(dir $$@)
	$$(Q)$$(CC) $$(GMI_KINS_CFLAGS) -o $$@ $$< -lm
TARGETS += ../cmod/$(1).so
modules: ../cmod/$(1).so
endef

# --- Group 0: trivkins ---
$(eval $(call GMI_KINS_BUILD,trivkins,cnc/kinematics))

# --- Group A: simple non-switchable (no HAL pins) ---
$(eval $(call GMI_KINS_BUILD,corexykins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,rotatekins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,scorbot-kins,cnc/kinematics))

# --- Group B: non-switchable with HAL pins ---
$(eval $(call GMI_KINS_BUILD,lineardeltakins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,rotarydeltakins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,maxkins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,rosekins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,tripodkins,cnc/kinematics))

# --- Group C: switchkins-based ---
$(eval $(call GMI_KINS_BUILD,5axiskins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,xyzac-trt-kins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,xyzbc-trt-kins,cnc/kinematics))
$(eval $(call GMI_KINS_BUILD,scarakins,cnc/kinematics))

# --- Group D: with posemath linkage ---
GMI_POSEMATH_INCDIR := posemath

define GMI_KINS_POSEMATH_BUILD
../cmod/$(1).so: $(2)/$(1).c ../lib/libposemath.so $$(GMI_KINS_DEPS)
	$$(ECHO) "Compiling GMI cmod $$(notdir $$@)"
	@mkdir -p $$(dir $$@)
	$$(Q)$$(CC) $$(GMI_KINS_CFLAGS) -I $$(GMI_POSEMATH_INCDIR) -I rtapi -o $$@ $$< -L../lib -lposemath -lm
TARGETS += ../cmod/$(1).so
modules: ../cmod/$(1).so
endef

$(eval $(call GMI_KINS_POSEMATH_BUILD,genhexkins,cnc/kinematics))
$(eval $(call GMI_KINS_POSEMATH_BUILD,genserkins,cnc/kinematics))
$(eval $(call GMI_KINS_POSEMATH_BUILD,pumakins,cnc/kinematics))
$(eval $(call GMI_KINS_POSEMATH_BUILD,pentakins,cnc/kinematics))

