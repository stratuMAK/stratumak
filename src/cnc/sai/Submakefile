TARGETS += ../bin/rs274
#  builtin_modules.cc
SAISRCS := $(addprefix cnc/sai/, saicanon.cc driver.cc sai_tooltable.cc)
USERSRCS += $(SAISRCS)

# interp_internal.hh transitively includes canon_api.h via canon_interface.hh
$(call TOOBJSDEPS, $(SAISRCS)): stmak/generated/gmi/canon/canon_api.h
# interp_ext.h transitively includes interp_ext_api.h / interp_ctx_api.h
$(call TOOBJSDEPS, $(SAISRCS)): EXTRAFLAGS += -Istmak/generated/gmi/interp_ext -Istmak/generated/gmi/interp_ctx
$(call TOOBJSDEPS, $(SAISRCS)): stmak/generated/gmi/interp_ext/interp_ext_api.h stmak/generated/gmi/interp_ctx/interp_ctx_api.h

INCLUDES += cnc/sai

# Libraries linked -l-style, not as .so.0 paths in $^ — see mb2hal's
# Submakefile for the clang driver trap behind this shape.
../bin/rs274: $(call TOOBJS, $(SAISRCS)) ../lib/librs274.so.0 \
	../lib/libiniparse.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) -rdynamic -o $@ $(filter %.o,$^) -L../lib -l:librs274.so.0 -l:libiniparse.so.0 $(ULFLAGS) $(READLINE_LIBS) $(LDFLAGS)

$(patsubst ./cnc/sai/%,../include/%,$(wildcard ./cnc/sai/*.h)): ../include/%.h: ./cnc/sai/%.h
	cp $^ $@
$(patsubst ./cnc/sai/%,../include/%,$(wildcard ./cnc/sai/*.hh)): ../include/%.hh: ./cnc/sai/%.hh
	cp $^ $@

