STEPCONF_MODULES = pages build_INI build_HAL import_mach 

STEPCONF_GLADEFILES := \
	main_page.glade \
	base.glade \
	start.glade \
	pport1.glade \
	pport2.glade \
	spindle.glade \
	options.glade \
	halui_page.glade \
	ubuttons.glade \
	thcad.glade \
	axisx.glade \
	axisy.glade \
	axisz.glade \
	axisu.glade \
	axisv.glade \
	axisa.glade \
	finished.glade \

PYTARGETS += ../bin/stepconf  ../lib/python/stepconf/__init__.py ../share/stratumak/linuxcnc-wizard.gif $(patsubst %,../lib/python/stepconf/%.py,$(STEPCONF_MODULES)) \
	$(patsubst %, ../share/stratumak/stepconf/%, $(STEPCONF_GLADEFILES)) \

PYI18NSRCS += cnc/usr_intf/stepconf/stepconf.py $(patsubst %,cnc/usr_intf/stepconf/%.py,$(STEPCONF_MODULES)) \
	$(patsubst %, cnc/usr_intf/stepconf/%, $(STEPCONF_GLADEFILES)) \

../lib/python/stepconf/__init__.py:
	$(ECHO) building python init $(notdir $@)
	$(Q)mkdir -p ../lib/python/stepconf
	$(Q)touch $@

../lib/python/stepconf/%.py: cnc/usr_intf/stepconf/%.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)mkdir -p ../lib/python/stepconf
	$(Q)cp $< $@

../share/stratumak/stepconf/%.glade: cnc/usr_intf/stepconf/%.glade
	$(ECHO) Copying glade file $(notdir $@)
	$(Q)mkdir -p $(dir $@)
	$(Q)cp -f $< $@

# stepconf and pncconf load the wizard image from the share directory itself,
# not from images/ (stepconf.py joins it onto datadir, pncconf onto DATADIR),
# so a run-in-place tree still needs the copy one level up. qtvcp is unrelated
# here: it has its own copy under lib/python/qtvcp/widgets/widget_icons/.
../share/stratumak/linuxcnc-wizard.gif: ../share/stratumak/images/linuxcnc-wizard.gif
	$(ECHO) Copying $(notdir $@)
	$(Q)cp $< $@

../bin/stepconf: cnc/usr_intf/stepconf/stepconf.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)(echo '#!$(PYTHON)'; sed '1 { /^#!/d; }' $<) > $@.tmp && chmod +x $@.tmp && mv -f $@.tmp $@
