TOUCHY_MODULES = mdi emc_interface hal_interface filechooser listing preferences

PYTARGETS += ../bin/touchy ../lib/python/touchy/__init__.py $(patsubst %,../lib/python/touchy/%.py,$(TOUCHY_MODULES)) \
	../share/stratumak/touchy.glade
PYI18NSRCS += cnc/usr_intf/touchy/touchy.py $(patsubst %,cnc/usr_intf/touchy/%.py,$(TOUCHY_MODULES)) \
	cnc/usr_intf/touchy/touchy.glade

../lib/python/touchy/__init__.py:
	@mkdir -p ../lib/python/touchy
	@touch $@

../lib/python/touchy/%: cnc/usr_intf/touchy/%
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)mkdir -p ../lib/python/touchy
	$(Q)cp $< $@

../share/stratumak/touchy.glade: cnc/usr_intf/touchy/touchy.glade
	$(ECHO) Copying glade file $(notdir $@)
	$(Q)mkdir -p $(dir $@)
	$(Q)cp -f $< $@

../bin/touchy: cnc/usr_intf/touchy/touchy.py
	@$(ECHO) Syntax checking python script $(notdir $@)
	$(Q)$(PYTHON) -m py_compile $<
	$(ECHO) Copying python script $(notdir $@)
	$(Q)(echo '#!$(PYTHON)'; sed '1 { /^#!/d; }' $<) > $@.tmp && chmod +x $@.tmp && mv -f $@.tmp $@
