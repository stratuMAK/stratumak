INCLUDES += inifile

$(patsubst ./inifile/%,../include/%,$(wildcard ./inifile/*.h)): ../include/%.h: ./inifile/%.h
	cp $^ $@
$(patsubst ./inifile/%,../include/%,$(wildcard ./inifile/*.hh)): ../include/%.hh: ./inifile/%.hh
	cp $^ $@

LIBINISRCS := inifile/iniparse.c
$(call TOOBJSDEPS, $(LIBINISRCS)) : EXTRAFLAGS=-fPIC

INIFILESRCS := inifile/inivar.cc

USERSRCS += $(INIFILESRCS) $(LIBINISRCS)
TARGETS += ../lib/libiniparse.so ../lib/libiniparse.so.0

../lib/libiniparse.so.0: $(call TOOBJS,$(LIBINISRCS))
	$(ECHO) Creating shared library $(notdir $@)
	@mkdir -p ../lib
	@rm -f $@
	$(Q)$(CC) $(LDFLAGS) -Wl,-soname,$(notdir $@) -shared -o $@ $^

../bin/inivar: $(call TOOBJS, $(INIFILESRCS)) ../lib/libiniparse.so.0
	$(ECHO) Linking $(notdir $@)
	$(Q)$(CXX) $(LDFLAGS) -o $@ $^ 
TARGETS += ../bin/inivar
