#!/bin/bash
#set -x

WARN_ON_FAILURE=0
if [ "$1" = "--warn-on-failure" ]; then
    WARN_ON_FAILURE=1
    shift
fi

LANGUAGE="$1"
shift

FILES="$@"

if [ -z $(which linuxcnc-checklink) ]; then
    echo "ERROR: checklink not found, install w3c-linkchecker for HTML link validation" 1>&2
    exit 1
fi


BAD_LINKS=0
for F in $FILES; do
    # The make rules pass $^, which carries the .htmldoc-stamp prerequisite
    # along with the documents; checklink then complains that its Content-Type
    # is text/plain.  Only HTML is a document here.
    case $F in
        *.html) ;;
        *) continue ;;
    esac
    OUT=.checklink.$LANGUAGE.$(basename $F).tmp
    rm -f $OUT
    # --follow-file-links is what makes this check do anything at all.  Without
    # it checklink refuses every file: URI -- which is every link between two
    # local documents, i.e. all this pass exists to verify -- prints "Error:
    # 500 Access to 'file' URIs has been disabled" and does not count the
    # refusal as a broken link.  The result was "all links are good" reported
    # over a run that had validated nothing: a page linking to a nonexistent
    # file passed silently.
    #
    # The grep drops a Perl warning checklink itself emits from an
    # uninitialized match while following file: URIs; it is noise from the
    # tool, not a finding, and would otherwise replace one flood with another.
    linuxcnc-checklink --quiet --follow-file-links --exclude "(http|https|irc)://" $F 2>&1 \
        | grep -v 'Use of uninitialized value' | tee $OUT
    egrep -q 'List of (broken links and other issues|duplicate and empty anchors)' $OUT
    if [ $? -ne 1 ]; then
        BAD_LINKS=1
    fi
    rm -f $OUT
done

if [ $BAD_LINKS -eq 1 ]; then
    RET_VAL=1
    echo "***" 1>&2
    echo "*** warning: bad links found in $LANGUAGE docs!" 1>&2
    if [ $WARN_ON_FAILURE -eq 1 ]; then
        echo "*** oh well, continuing anyway" 1>&2
        RET_VAL=0
    fi
    echo "***" 1>&2
    exit $RET_VAL
else
    echo "###"
    echo "### language: $LANGUAGE"
    echo "### all links are good!"
    echo "###"
fi

