component out8 "Digital output card driver (example)";

pin out unsigned out_ "Output value; only the low 8 bits are used";
param r unsigned base "The I/O port this instance drives";

modparam int ioaddr = 0 "I/O port address of the board this instance drives";

option extra_setup;
option extra_cleanup;

function _;

license "GPL";
;;
#include <errno.h>
#include "rtapi_io.h"

// One instance per board, each given its address on its own load line:
//
//     load out8 <out8.0> ioaddr=0x378
//     load out8 <out8.1> ioaddr=0x278
//
// There is no I/O region to request: stratuMAK takes iopl(3) once during RTAPI
// startup (it needs cap_sys_rawio), so every instance can already reach the
// port.  EXTRA_SETUP publishes the address as a HAL parameter and drives the
// outputs to a known state; EXTRA_CLEANUP puts them back, so unloading the
// module does not leave the outputs energised.

EXTRA_SETUP() {
    (void)name; (void)nparams; (void)params;

    if (ioaddr == 0) {
        STMAK_LOG_ERR("no ioaddr= given on the load line");
        return -EINVAL;
    }
    base = (unsigned)ioaddr;
    rtapi_outb(0, base);
    return 0;
}

EXTRA_CLEANUP() {
    if (base != 0) {
        rtapi_outb(0, base);
    }
}

FUNCTION(_) { rtapi_outb(out_ & 0xff, base); }
