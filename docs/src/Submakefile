clean: clean-manpages clean-mandb clean-translated
clean-manpages:
	-rm -f $(GENERATED_MANPAGES)
# Ordered after clean-translated, which deletes whole $(DOC_SRCDIR)/<lang>
# trees: run concurrently, it removes them while the find below is walking
# them and find exits non-zero on each directory that vanishes underneath it,
# failing the whole clean. Only reproducible under -j, which is why a serial
# clean passes and `dpkg-buildpackage` with DEB_BUILD_OPTIONS=parallel fails.
clean-mandb: clean-translated
clean-mandb:
	find $(DOC_SRCDIR) -name 'index*db' -delete
clean-translated:
	-$(RM) -r $(GENERATED_TRANSLATED)

# The first find runs from src/ and walks the whole tree, which used to include
# the EtherCAT master submodule: we rendered its documentation graphs and left
# ten generated .svg files sitting in another project's checkout. Its docs are
# its own to build. Prune it; only emc/motion/homing.dot here is ours.
DOTFILES=$(shell find . -name "*.dot" -not -path "./hal/drivers/ethercat/master/*") \
         $(shell find ../docs/src/ -name "*.dot")
