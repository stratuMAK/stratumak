# Time how long po4a takes to run if the system has the `time` command
# installed, but just skip timing and don't fail the build if it's
# not available.
TIME_CMD := $(shell which time || true)
ifneq (${TIME_CMD},)
    TIME_CMD := ${TIME_CMD} -v
endif

# Refreshing the translation template is a maintainer action, not a build step.
# po4a --no-translations rewrites docs/po/documentation.pot *and* msgmerges all
# of the tracked docs/po/*.po files against it, which marks changed entries
# fuzzy -- and a fuzzy entry renders untranslated.  Regenerating therefore drops
# translations from the shipped documents, so it has to be a reviewed commit of
# its own and must never happen as a side effect of `make docs`.  This mirrors
# src/po/Submakefile, where `pofiles` is likewise the only target that
# msgmerges.  Building the documents below uses the committed .po files exactly
# as they are (--no-update, which leaves the POT and PO files alone).
#
# Both targets need the generated masters that po4a.cfg lists: gen_complist
# writes src/hal/components_gen.adoc, and manpages writes the 111 man/man9
# pages that modcompile produces from the .comp sources.  po4a aborts outright
# if a master file is missing, and if one is merely absent from an otherwise
# complete run the regenerated template loses every message it contributed --
# roughly 2300 German translations for the man pages alone.
# The recipe hangs off docs-pofiles, not pofiles: src/po/Submakefile already
# attaches a recipe to pofiles for the program catalogues, and two recipes for
# one target means make discards one of them with a warning.  Depending on it
# instead keeps `make pofiles` refreshing both sets.
.PHONY: docs-pofiles
docs-pofiles: manpages gen_complist
	cd $(DOC_DIR); ${TIME_CMD} po4a -v --msgmerge-opt='-v' --no-translations po4a.cfg
pofiles: docs-pofiles

ifeq ($(BUILD_DOCS_TRANSLATED),yes)
# One po4a run writes every translated source, so a stamp stands for that one
# action and the generated .adoc files are declared as its products below.
# Without that declaration make has no rule for them: with the lists derived
# rather than globbed the targets are known from the first pass, and make
# would stop with "no rule to make target ../docs/src/de/hal/intro.adoc".
.translateddocs-stamp: manpages gen_complist $(DOC_DIR)/po4a.cfg \
		$(addprefix $(DOC_SRCDIR)/, $(DOC_SRCS_EN)) $(wildcard $(DOC_DIR)/po/*.po)
	cd $(DOC_DIR); ${TIME_CMD} po4a -v --msgmerge-opt='-v' --no-update po4a.cfg
	@touch $@
translateddocs: .translateddocs-stamp

