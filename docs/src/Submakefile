DOC_SRCS_NB = $(addprefix nb/, $(DOC_SRCS_TRANSLATED))

# Declared here, not up with the .translateddocs-stamp rule: a rule's target
# list is expanded the moment make reads it, so stating this before
# DOC_SRCS_* exist expands to nothing and the rule silently covers no files --
# make then stops with "no rule to make target ../docs/src/de/README.adoc".
ifeq ($(BUILD_DOCS_TRANSLATED),yes)
$(addprefix $(DOC_SRCDIR)/, $(DOC_SRCS_DE) $(DOC_SRCS_ES) $(DOC_SRCS_FR) $(DOC_SRCS_NB)): .translateddocs-stamp
