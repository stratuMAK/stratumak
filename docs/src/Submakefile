	done

# The translated sources are whatever po4a writes under src/$lang, so the list
# is derived from po4a.cfg rather than globbed.  That is not a style choice:
# $(wildcard) expands when the makefile is parsed, and on a clean tree these
# files do not exist yet -- so every DOC_SRCS_<LANG> came out empty, no
# translated HTML target existed at all, and `make docs` had to be run twice
# before it produced a complete tree.
#
# The filters reproduce exactly what the wildcards matched (verified equal at
# 137 files per language): only .adoc, nothing under man/ -- the wildcards
# reached one directory deep -- and not components_gen.adoc, which is a
# fragment for inclusion into components.adoc rather than a document.  It
# opens at level 2, so asciidoc warns "section title out of sequence" when
# compiled standalone; DOC_SRCS_EN names its files individually and never
# picked it up, but the wildcards did, which is why only the translations
# warned.
PO4A_SRCS := $(shell sed -n 's|^\[type:[^]]*\][[:space:]]*[^[:space:]]*[[:space:]]*$$lang:src/$$lang/\(.*\)$$|\1|p' $(DOC_DIR)/po4a.cfg)
DOC_SRCS_TRANSLATED := $(filter-out man/% %/components_gen.adoc, $(filter %.adoc, $(PO4A_SRCS)))

